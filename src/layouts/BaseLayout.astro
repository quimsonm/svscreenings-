---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
}

const { title, description, ogImage = '/og-image.jpg', canonical } = Astro.props;
const canonicalUrl = canonical || new URL(Astro.url.pathname, 'https://svscreenings.com').href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <!-- Google Analytics (GA4) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-CZRBE70YJM"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-CZRBE70YJM');
      window.svs_track = function(eventName, params) {
        if (typeof gtag === 'function') {
          gtag('event', eventName, params);
        }
      };
    </script>

    <!-- UTM Capture: saves utm_source/medium/campaign + gclid to sessionStorage on first touch -->
    <script is:inline>
      (function() {
        var params = new URLSearchParams(window.location.search);
        ['utm_source','utm_medium','utm_campaign','gclid'].forEach(function(key) {
          var val = params.get(key);
          if (val) sessionStorage.setItem(key, val);
        });
        window.intakeqUtmSource   = sessionStorage.getItem('utm_source')   || 'direct';
        window.intakeqUtmMedium   = sessionStorage.getItem('utm_medium')   || 'none';
        window.intakeqUtmCampaign = sessionStorage.getItem('utm_campaign') || 'none';
      })();
    </script>

    <!-- Meta Pixel -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '2602063206805705');
      fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=2602063206805705&ev=PageView&noscript=1" /></noscript>

    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Signal View Ultrasound" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display&display=swap" rel="stylesheet" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />

    <title>{title}</title>

    <!-- Structured Data -->
    <slot name="schema" />

    <!-- Healthy Bites popup: viewport centering + mobile sizing -->
    <style>
      div:has(> #popup-hm0FFkIf2lsBdJV94YwG),
      div:has(iframe[data-form-id="hm0FFkIf2lsBdJV94YwG"]) {
        position: fixed !important;
        top: 50% !important;
        left: 50% !important;
        transform: translate(-50%, -50%) !important;
        z-index: 999999 !important;
        width: 560px !important;
        max-width: 92vw !important;
        border-radius: 12px !important;
        overflow: hidden !important;
      }
      @media (max-width: 640px) {
        div:has(> #popup-hm0FFkIf2lsBdJV94YwG),
        div:has(iframe[data-form-id="hm0FFkIf2lsBdJV94YwG"]) {
          width: 92vw !important;
          max-height: 75vh !important;
          overflow-y: auto !important;
        }
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Scroll animation observer -->
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
      );

      document.querySelectorAll('.fade-in-up').forEach((el) => {
        observer.observe(el);
      });
    </script>
    <script src="https://widgets.leadconnectorhq.com/loader.js" data-resources-url="https://widgets.leadconnectorhq.com/chat-widget/loader.js" data-widget-id="6a7a049da8b7a425b34a6f99" data-source="WEB_USER" is:inline></script>

    <!-- Healthy Bites popup: once per session + smooth fade-in -->
    <script is:inline>
      (function() {
        var FORM_ID = 'hm0FFkIf2lsBdJV94YwG';
        var SHOWN_KEY = 'svs-hb-shown';

        // If already shown this session, remove the iframe before GHL processes it
        if (sessionStorage.getItem(SHOWN_KEY)) {
          document.addEventListener('DOMContentLoaded', function() {
            var el = document.getElementById('popup-' + FORM_ID);
            if (el) el.parentNode.removeChild(el);
          });
          return;
        }

        function fadeIn(node) {
          if (!node || node._svsAnimated) return;
          node._svsAnimated = true;
          sessionStorage.setItem(SHOWN_KEY, '1');
          node.style.opacity = '0';
          node.style.transition = 'opacity 0.5s cubic-bezier(0.22,1,0.36,1)';
          requestAnimationFrame(function() {
            requestAnimationFrame(function() {
              node.style.opacity = '1';
            });
          });
        }

        // Only watch direct children of body — GHL appends its modal directly there
        var obs = new MutationObserver(function(mutations) {
          mutations.forEach(function(m) {
            m.addedNodes.forEach(function(node) {
              if (node.nodeType !== 1) return;
              if (
                node.querySelector('#popup-' + FORM_ID) ||
                node.querySelector('iframe[data-form-id="' + FORM_ID + '"]')
              ) {
                fadeIn(node);
                obs.disconnect();
              }
            });
          });
        });

        document.addEventListener('DOMContentLoaded', function() {
          obs.observe(document.body, { childList: true, subtree: false });
        });
      })();
    </script>

    <!-- Healthy Bites newsletter popup -->
    <iframe
      src="https://api.leadconnectorhq.com/widget/form/hm0FFkIf2lsBdJV94YwG"
      style="display:none;width:100%;height:100%;border:none;border-radius:8px"
      id="popup-hm0FFkIf2lsBdJV94YwG"
      data-layout="{'id':'POPUP'}"
      data-trigger-type="showAfter"
      data-trigger-value="10"
      data-activation-type="alwaysActivated"
      data-activation-value=""
      data-deactivation-type="neverDeactivate"
      data-deactivation-value=""
      data-form-name="Healthy Bites"
      data-height="undefined"
      data-layout-iframe-id="popup-hm0FFkIf2lsBdJV94YwG"
      data-form-id="hm0FFkIf2lsBdJV94YwG"
      data-cookie-consent="true"
      data-cookie-consent-provider="auto"
      title="Healthy Bites"
      data-modal-height="500"
    ></iframe>
    <script src="https://link.msgsndr.com/js/form_embed.js" is:inline></script>
  </body>
</html>
