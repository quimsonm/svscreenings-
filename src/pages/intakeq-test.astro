---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Book Your Screening | Signal View Screenings"
  description="Schedule your diagnostic ultrasound screening with Signal View Screenings in Las Vegas."
>
  <!-- Hero -->
  <section class="bg-navy-dark py-16 px-6 text-center">
    <p class="overline text-gold mb-3">Schedule Online</p>
    <h1 class="text-4xl md:text-5xl font-serif text-white mb-4">Book Your Screening</h1>
    <p class="text-white/70 text-lg max-w-xl mx-auto">
      Select your service, choose a time, and complete your intake — all in one place.
    </p>
  </section>

  <!-- Widget Section -->
  <section class="section-padding bg-ivory">
    <div class="max-w-3xl mx-auto fade-in-up">
      <div id="intakeq" style="max-width:720px; width: 100%;"></div>
    </div>
  </section>
</BaseLayout>

<script>
  (function (c) {
    window.intakeq = "6a34384c4c7aa072929fbe5f";
    window.intakeqServiceId = "f5383369-eac5-4cdb-aef5-1907cd466681";
    var i = c.createElement("script");
    i.type = "text/javascript";
    i.async = true;
    i.src = "https://intakeq.com/js/widget.min.js?1";
    document.head.appendChild(i);
  })(document);
</script>
