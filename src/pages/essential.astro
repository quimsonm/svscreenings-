---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import EmergencyBanner from '../components/EmergencyBanner.astro';
import { Image } from 'astro:assets';
import essentialHero from '../assets/images/carotid-screening.jpg';
import { siteConfig } from '../data/siteConfig';

const trustPoints = [
  { icon: 'clock', text: '45–60 Minutes' },
  { icon: 'shield', text: 'No Referral Needed' },
  { icon: 'heart', text: 'No Needles or Radiation' },
  { icon: 'check', text: 'Physician-Interpreted Results' },
];

const included = [
  {
    name: 'Carotid Artery Ultrasound',
    conditions: 'Plaque buildup, stenosis, stroke risk',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="8"/><path d="M12 4v16M8 8c2 2 4 2 6 0M8 16c2-2 4-2 6 0" stroke-linecap="round"/></svg>`,
  },
  {
    name: 'Aortic Aneurysm Screening',
    conditions: 'AAA detection and aortic diameter',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M12 3v4M12 17v4M10 7c-2 2-3 4-3 7s1 3 3 3h4c2 0 3 0 3-3s-1-5-3-7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="1.5"/></svg>`,
  },
  {
    name: 'Leg Arterial (PAD) Screening',
    conditions: 'Peripheral artery disease, blood flow',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M11 3c0 2-1 5-1 8s1 5 1 8M13 3c0 2 1 5 1 8s-1 5-1 8" stroke-linecap="round"/><path d="M9 9h6M9 15h6" stroke-linecap="round" opacity="0.5"/></svg>`,
  },
];

const whyWait = [
  {
    stat: '$2,500+',
    heading: 'if done separately at a hospital',
    description: 'Three individual vascular scans through insurance or a hospital could run $2,500 or more. Our package bundles all three for $199.',
  },
  {
    stat: '3 scans',
    heading: 'in one single appointment',
    description: 'Carotid, aorta, and leg arteries — the most common sites of silent vascular disease — all covered in one visit.',
  },
  {
    stat: 'Same week',
    heading: 'appointments available',
    description: 'No referrals, no insurance delays, no weeks of waiting. Book online and come in this week.',
  },
];

const whoShouldGet = [
  'Men and women aged 55 or older',
  'Smokers or former smokers',
  'Family history of stroke or heart disease',
  'High blood pressure or high cholesterol',
  'Diabetes',
  'Annual cardiovascular health check',
];
---

<BaseLayout
  title="Essential Wellness Screening | $199 Vascular Package Las Vegas | Signal View"
  description="$199 Essential Wellness package in Las Vegas. Includes carotid, aorta, and leg arterial ultrasound in one appointment. Physician-interpreted results in 2–3 days."
>
  <EmergencyBanner />

  <!-- Hero -->
  <section class="relative overflow-hidden bg-navy">
    <div class="absolute inset-0 bg-gradient-to-br from-navy-dark/60 to-transparent"></div>
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-gold/5 rounded-full -translate-y-1/3 translate-x-1/3"></div>
    <div class="absolute bottom-0 left-0 w-[300px] h-[300px] bg-gold/3 rounded-full translate-y-1/2 -translate-x-1/3"></div>

    <div class="container-site relative py-20 md:py-28">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

        <div class="order-first lg:order-last fade-in-up">
          <Image
            src={essentialHero}
            alt="Sonographer performing a vascular ultrasound screening at Signal View Screenings in Las Vegas"
            class="rounded-2xl shadow-2xl shadow-black/30 w-full"
            widths={[480, 768, 1024]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            quality={85}
          />
        </div>

        <div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif text-white leading-tight mb-4 fade-in-up">
            Three Vascular Screenings. One Appointment. $199.
          </h1>
          <p class="text-xl md:text-2xl text-white/80 font-sans mb-2 fade-in-up">
            <span class="text-gold font-semibold">$199</span> · Essential Wellness Screening Package
          </p>
          <p class="text-lg text-white/60 font-sans mb-8 max-w-2xl fade-in-up">
            The Essential Wellness package covers the three most common sites of silent vascular disease — carotid arteries, aorta, and leg blood flow — all in a single visit. Physician-interpreted results in 2–3 business days. No referral needed.
          </p>

          <!-- IntakeQ booking widget -->
          <div class="mb-8 fade-in-up" id="book">
            <div id="intakeq" style="width: 100%;"></div>
          </div>

          <!-- Trust strip -->
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 fade-in-up">
            {trustPoints.map((point) => (
              <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-full bg-gold/15 flex items-center justify-center shrink-0">
                  {point.icon === 'clock' && (
                    <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" />
                    </svg>
                  )}
                  {point.icon === 'shield' && (
                    <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    </svg>
                  )}
                  {point.icon === 'heart' && (
                    <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z" />
                    </svg>
                  )}
                  {point.icon === 'check' && (
                    <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  )}
                </div>
                <span class="text-sm text-white/70 font-sans">{point.text}</span>
              </div>
            ))}
          </div>

          <!-- Location -->
          <div class="mt-6 flex items-start gap-2.5 text-sm text-white/70 font-sans fade-in-up">
            <svg class="w-4 h-4 text-gold shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <p class="leading-relaxed">
              {siteConfig.screeningLocation.address} · {siteConfig.screeningLocation.floor} · {siteConfig.screeningLocation.landmark}
              <a href={siteConfig.screeningLocation.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="text-gold hover:text-gold-light transition-colors whitespace-nowrap ml-1">— Get Directions →</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What's Included -->
  <section class="section-padding bg-white">
    <div class="container-site">
      <div class="text-center max-w-2xl mx-auto mb-12 fade-in-up">
        <p class="overline text-gold mb-3">Package Includes</p>
        <h2 class="text-3xl md:text-4xl font-serif text-charcoal">Three Screenings. One Visit. Full Vascular Picture.</h2>
        <p class="mt-4 text-base text-slate font-sans">Each scan targets a different area of your vascular system. Together they cover the most common causes of silent cardiovascular disease — all for less than a single hospital scan.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto fade-in-up">
        {included.map((item) => (
          <div class="p-6 rounded-2xl border border-warmgray/20 bg-ivory/50 text-center">
            <div class="w-14 h-14 bg-gold/10 rounded-full flex items-center justify-center mb-4 text-gold mx-auto" set:html={item.icon} />
            <h3 class="font-sans font-semibold text-charcoal text-base mb-2">{item.name}</h3>
            <p class="text-sm text-slate font-sans">{item.conditions}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Wait? -->
  <section class="section-padding bg-ivory">
    <div class="container-site">
      <div class="text-center max-w-2xl mx-auto mb-12 fade-in-up">
        <p class="overline text-gold mb-3">Skip the Runaround</p>
        <h2 class="text-3xl md:text-4xl font-serif text-charcoal">Why Wait Weeks When You Can Know This Week?</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        {whyWait.map((item) => (
          <div class="text-center p-6 rounded-2xl border border-warmgray/30 bg-white fade-in-up">
            <p class="text-5xl font-serif text-gold mb-2">{item.stat}</p>
            <p class="text-lg font-sans font-semibold text-charcoal mb-2">{item.heading}</p>
            <p class="text-sm text-slate font-sans leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Who Should Get This Package -->
  <section class="section-padding bg-white">
    <div class="container-site max-w-4xl">
      <div class="text-center mb-10 fade-in-up">
        <p class="overline text-gold mb-3">Is This For You?</p>
        <h2 class="text-3xl md:text-4xl font-serif text-charcoal">You Should Get This Package If...</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-2xl mx-auto fade-in-up">
        {whoShouldGet.map((item) => (
          <div class="flex items-center gap-3 p-4 rounded-xl bg-ivory border border-warmgray/20">
            <div class="w-8 h-8 rounded-full bg-gold/15 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </div>
            <span class="text-base font-sans text-charcoal">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Social Proof -->
  <section class="section-padding bg-ivory">
    <div class="container-site max-w-3xl text-center fade-in-up">
      <div class="flex items-center justify-center gap-1 mb-3">
        {[1,2,3,4,5].map(() => (
          <svg class="w-7 h-7 text-gold" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
        ))}
      </div>
      <p class="text-lg font-sans text-charcoal mb-2">5-Star Rated on Google</p>
      <p class="text-slate font-sans text-sm mb-6">Real reviews from real patients in Las Vegas</p>
      <a href={siteConfig.googleReviewsUrl} target="_blank" rel="noopener noreferrer" class="text-sm font-sans font-medium text-navy hover:text-gold transition-colors">
        Read Our Reviews →
      </a>
    </div>
  </section>

  <!-- Final CTA -->
  <CTABanner
    heading="Your Heart Health Can't Wait. Get the Full Picture."
    subtext="$199 · Three vascular screenings in one visit · Physician-interpreted results in 2–3 business days"
    ctaText="Book Essential Wellness — $199"
    ctaHref="#book"
  />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "MedicalTest",
    "name": "Essential Wellness Vascular Screening Package",
    "description": "A bundled vascular screening package including carotid artery, aortic aneurysm, and leg arterial (PAD) ultrasounds. Physician-interpreted results in 2–3 business days.",
    "usesDevice": { "@type": "MedicalDevice", "name": "Ultrasound" },
    "offers": {
      "@type": "Offer",
      "name": "Essential Wellness Package",
      "price": "199",
      "priceCurrency": "USD"
    },
    "provider": {
      "@type": "MedicalBusiness",
      "name": siteConfig.legalName,
      "telephone": siteConfig.phone,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": siteConfig.screeningLocation.address,
        "addressLocality": siteConfig.screeningLocation.city,
        "addressRegion": siteConfig.screeningLocation.state
      }
    }
  })} />
</BaseLayout>

<script is:inline>
  (function (c) {
    window.intakeq = "6a34384c4c7aa072929fbe5f";
    window.intakeqServiceId = "f5383369-eac5-4cdb-aef5-1907cd466681";
    var i = c.createElement("script");
    i.type = "text/javascript";
    i.async = true;
    i.src = "https://intakeq.com/js/widget.min.js?1";
    document.head.appendChild(i);
  })(document);
</script>
