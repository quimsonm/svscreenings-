---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import EmergencyBanner from '../components/EmergencyBanner.astro';
import { Image } from 'astro:assets';
import thyroidHero from '../assets/images/thyroid-hero.png';
import thyroidCloseup from '../assets/images/thyroid-closeup.png';
import teamMike from '../assets/images/Mike.jpg';
import teamJackie from '../assets/images/Jackie.jpg';
import teamPriya from '../assets/images/Priya.jpg';
import teamRemi from '../assets/images/Remi.jpg';
import { siteConfig } from '../data/siteConfig';
import { testimonials } from '../data/testimonials';
import { link } from '../utils/links';

const team = [
  { name: 'Mike', role: 'Sonographer', image: teamMike },
  { name: 'Jackie', role: 'Sonographer', image: teamJackie },
  { name: 'Priya', role: 'Sonographer', image: teamPriya },
  { name: 'Remi', role: 'Sonographer', image: teamRemi },
];

const studies = [
  {
    name: 'Carotid Artery Ultrasound',
    description: 'Imaging of the neck arteries that supply blood to your brain.',
    detail: 'Flags plaque buildup that elevates stroke risk.',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 4v16M8 8c2 2 4 2 6 0M8 16c2-2 4-2 6 0" stroke-linecap="round"/></svg>`,
    highlight: false,
  },
  {
    name: 'Abdominal Aorta Ultrasound',
    description: "Imaging of the body's main artery in the abdomen.",
    detail: 'Screens for aortic aneurysm — often called the "silent killer."',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path d="M12 3v4M12 17v4M10 7c-2 2-3 4-3 7s1 3 3 3h4c2 0 3 0 3-3s-1-5-3-7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="1.5"/></svg>`,
    highlight: false,
  },
  {
    name: 'Leg Artery Screening with ABI',
    description: 'Imaging of the arteries from thigh to ankle.',
    detail: 'Screens for peripheral artery disease (PAD) and reduced circulation.',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path d="M11 3c0 2-1 5-1 8s1 5 1 8M13 3c0 2 1 5 1 8s-1 5-1 8" stroke-linecap="round"/><path d="M9 9h6M9 15h6" stroke-linecap="round" opacity="0.5"/></svg>`,
    highlight: false,
  },
  {
    name: 'Screening Echocardiogram',
    description: 'Quick ultrasound check of heart function and valves.',
    detail: 'Ejection fraction (EF) and valve screening — flags concerns worth deeper investigation.',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
    highlight: false,
  },
  {
    name: 'Abdomen Complete Ultrasound',
    description: 'Imaging of liver, gallbladder, kidneys, spleen, and pancreas.',
    detail: 'Screens for gallstones, cysts, fatty liver, and organ abnormalities.',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><ellipse cx="12" cy="13" rx="7" ry="6"/><path d="M9 7c0-3 6-3 6 0M8 10c1 1 6 1 8-1" stroke-linecap="round"/></svg>`,
    highlight: true,
  },
  {
    name: 'Thyroid Ultrasound',
    description: 'Imaging of the thyroid gland at the base of the neck.',
    detail: 'Screens for nodules, enlargement, and structural abnormalities.',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path d="M12 3c-2 2-4 5-4 9s2 7 4 9c2-2 4-5 4-9s-2-7-4-9z" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 10c1.5 1 6.5 1 8-1" stroke-linecap="round"/></svg>`,
    highlight: true,
  },
];

const whoShouldGet = [
  "You're 45 or older and want a full-body baseline",
  'Family history of heart disease, stroke, or cancer',
  'High blood pressure, high cholesterol, or diabetes',
  'Unexplained fatigue, weight changes, or digestive symptoms',
  'Smoker or former smoker',
  'You want everything checked in one appointment',
];
---

<BaseLayout
  title="The Gold Standard Full Body Scan Las Vegas | $697 | Signal View Ultrasound"
  description="Six ultrasound studies in one 60-minute visit — heart, vascular, abdomen, and thyroid. Physician-interpreted report included. $697. Las Vegas, no referral needed."
>
  <EmergencyBanner />

  <!-- Hero -->
  <section class="relative overflow-hidden bg-navy">
    <div class="absolute inset-0 bg-gradient-to-br from-navy-dark/60 to-transparent"></div>
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-gold/5 rounded-full -translate-y-1/3 translate-x-1/3"></div>
    <div class="absolute bottom-0 left-0 w-[300px] h-[300px] bg-gold/3 rounded-full translate-y-1/2 -translate-x-1/3"></div>

    <div class="container-site relative py-12 md:py-16">
      <div class="grid grid-cols-1 gap-8">
        <div class="fade-in-up">
          <p class="overline text-gold mb-4">Most Comprehensive Screening in Las Vegas</p>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif text-white leading-tight mb-4">
            Six Studies. One Visit. Complete Peace of Mind.
          </h1>
          <p class="text-lg md:text-xl text-white/85 font-sans mb-2">
            <span class="text-gold font-semibold">$697</span> · Heart + Vascular + Abdomen + Thyroid — All in 60 Minutes
          </p>
          <p class="text-base text-white/70 font-sans mb-6 max-w-2xl">
            The most thorough screening we offer. Six ultrasound studies reviewed by a board-certified physician — in a single in-clinic visit.
          </p>

          <!-- Hero image -->
          <div class="mb-6 fade-in-up">
            <Image
              src={thyroidHero}
              alt="Patient receiving a full body ultrasound screening at Signal View Ultrasound in Las Vegas"
              class="rounded-2xl shadow-2xl shadow-black/30 w-full"
              widths={[480, 768, 1024]}
              sizes="(max-width: 1024px) 100vw, 58vw"
              quality={85}
            />
          </div>

          <!-- What's included quick-glance — 3×2 grid for 6 studies -->
          <div class="grid grid-cols-3 md:grid-cols-6 gap-2 mb-6 max-w-2xl">
            <div class="bg-white/10 border border-white/15 rounded-lg p-3 backdrop-blur">
              <div class="text-gold mb-1">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 4v16M8 8c2 2 4 2 6 0M8 16c2-2 4-2 6 0" stroke-linecap="round"/></svg>
              </div>
              <p class="text-xs text-white font-sans font-semibold leading-tight">Carotid</p>
              <p class="text-[10px] text-white/60 font-sans">Stroke risk</p>
            </div>
            <div class="bg-white/10 border border-white/15 rounded-lg p-3 backdrop-blur">
              <div class="text-gold mb-1">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path d="M12 3v4M12 17v4M10 7c-2 2-3 4-3 7s1 3 3 3h4c2 0 3 0 3-3s-1-5-3-7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="1.5"/></svg>
              </div>
              <p class="text-xs text-white font-sans font-semibold leading-tight">Aorta</p>
              <p class="text-[10px] text-white/60 font-sans">Aneurysm</p>
            </div>
            <div class="bg-white/10 border border-white/15 rounded-lg p-3 backdrop-blur">
              <div class="text-gold mb-1">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path d="M11 3c0 2-1 5-1 8s1 5 1 8M13 3c0 2 1 5 1 8s-1 5-1 8" stroke-linecap="round"/></svg>
              </div>
              <p class="text-xs text-white font-sans font-semibold leading-tight">Leg Arteries (ABI)</p>
              <p class="text-[10px] text-white/60 font-sans">PAD</p>
            </div>
            <div class="bg-white/10 border border-white/15 rounded-lg p-3 backdrop-blur">
              <div class="text-gold mb-1">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              <p class="text-xs text-white font-sans font-semibold leading-tight">Echo</p>
              <p class="text-[10px] text-white/60 font-sans">Heart</p>
            </div>
            <div class="bg-white/10 border border-gold/30 rounded-lg p-3 backdrop-blur">
              <div class="text-gold mb-1">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><ellipse cx="12" cy="13" rx="7" ry="6"/><path d="M9 7c0-3 6-3 6 0M8 10c1 1 6 1 8-1" stroke-linecap="round"/></svg>
              </div>
              <p class="text-xs text-white font-sans font-semibold leading-tight">Abdomen</p>
              <p class="text-[10px] text-gold/80 font-sans">+New</p>
            </div>
            <div class="bg-white/10 border border-gold/30 rounded-lg p-3 backdrop-blur">
              <div class="text-gold mb-1">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path d="M12 3c-2 2-4 5-4 9s2 7 4 9c2-2 4-5 4-9s-2-7-4-9z" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 10c1.5 1 6.5 1 8-1" stroke-linecap="round"/></svg>
              </div>
              <p class="text-xs text-white font-sans font-semibold leading-tight">Thyroid</p>
              <p class="text-[10px] text-gold/80 font-sans">+New</p>
            </div>
          </div>

          <!-- IntakeQ booking widget -->
          <div class="mb-6 max-w-2xl" id="book">
            <div id="intakeq" style="width: 100%;"></div>
          </div>

          <!-- Trust strip -->
          <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-white/70 font-sans">
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              ARDMS-Certified Sonographers
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Physician-Read Reports
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              HSA/FSA Eligible
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              No Referral Needed
            </span>
          </div>

          <!-- Location -->
          <div class="mt-6 flex items-start gap-2.5 text-sm text-white/70 font-sans fade-in-up">
            <svg class="w-4 h-4 text-gold shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <p class="leading-relaxed">
              {siteConfig.screeningLocation.address} · {siteConfig.screeningLocation.floor} · {siteConfig.screeningLocation.landmark}
              <a href={siteConfig.screeningLocation.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="text-gold hover:text-gold-light transition-colors whitespace-nowrap ml-1">— Get Directions →</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What's Included -->
  <section class="section-padding bg-white">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center max-w-6xl mx-auto mb-12">
        <div class="fade-in-up">
          <p class="overline text-gold mb-3">What's Included</p>
          <h2 class="text-3xl md:text-4xl font-serif text-charcoal mb-4">Six Studies. One Comprehensive Picture.</h2>
          <p class="text-base text-slate font-sans leading-relaxed">Most screening packages stop at the heart and blood vessels. The Gold Standard goes further — adding a complete abdominal scan and thyroid imaging so your doctor gets a full picture of what's happening inside. Six studies. One 60-minute visit. One physician-interpreted report.</p>
        </div>
        <div class="fade-in-up">
          <Image
            src={thyroidCloseup}
            alt="Sonographer performing a thyroid ultrasound during a Gold Standard full body scan"
            class="rounded-2xl w-full aspect-[4/3] object-cover shadow-lg"
            widths={[480, 768]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            quality={85}
          />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 max-w-5xl mx-auto fade-in-up">
        {studies.map((study) => (
          <div class={study.highlight ? "bg-ivory/50 rounded-xl p-5 border-2 border-gold relative" : "bg-ivory/50 rounded-xl p-5 border border-warmgray/40"}>
            {study.highlight && (
              <div class="absolute -top-2 right-3 bg-gold text-white text-[10px] font-sans font-semibold px-2 py-0.5 rounded-full">GOLD STANDARD EXCLUSIVE</div>
            )}
            <div class={study.highlight ? "w-10 h-10 bg-gold/15 rounded-full flex items-center justify-center mb-3 text-gold" : "w-10 h-10 bg-gold/10 rounded-full flex items-center justify-center mb-3 text-gold"} set:html={study.icon} />
            <h3 class="font-sans font-semibold text-charcoal text-sm mb-1">{study.name}</h3>
            <p class="text-xs text-slate font-sans mb-2">{study.description}</p>
            <p class="text-xs text-slate font-sans">{study.detail}</p>
          </div>
        ))}
      </div>

      <p class="text-center text-xs text-slate font-sans italic mt-6 max-w-2xl mx-auto">
        Every study is performed in-clinic at our Summerlin location. The screening echocardiogram is a focused exam (EF and valve check) — not a full diagnostic echo. If a more detailed cardiac evaluation is needed, our <a href={link('/echo')} class="text-navy hover:text-gold underline transition-colors">full diagnostic echocardiogram</a> is available separately.
      </p>
    </div>
  </section>

  <!-- Why This Combination -->
  <section class="section-padding bg-ivory">
    <div class="container-site max-w-4xl">
      <div class="text-center mb-10 fade-in-up">
        <p class="overline text-gold mb-3">Why Six Studies</p>
        <h2 class="text-3xl md:text-4xl font-serif text-charcoal">The Conditions That Hurt You Most Don't Announce Themselves</h2>
        <p class="mt-4 text-base text-slate font-sans max-w-2xl mx-auto leading-relaxed">Plaque in the arteries. An aneurysm quietly expanding. Gallstones you've never felt. A thyroid nodule your doctor hasn't had reason to look for yet. None of these wave a flag. The Gold Standard scans the systems most likely to harbor silent disease — so you walk out knowing, not guessing.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 fade-in-up">
        <div class="bg-white rounded-2xl p-6 border border-warmgray/30 text-center">
          <p class="text-4xl font-serif text-gold mb-2">Up to 80%</p>
          <p class="text-sm text-slate font-sans">of strokes are preventable when vascular risk factors are identified and managed early</p>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-warmgray/30 text-center">
          <p class="text-4xl font-serif text-gold mb-2">1 in 10</p>
          <p class="text-sm text-slate font-sans">Americans has thyroid disease — and up to 60% are unaware of their condition</p>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-warmgray/30 text-center">
          <p class="text-4xl font-serif text-gold mb-2">~6,000</p>
          <p class="text-sm text-slate font-sans">aortic aneurysm deaths per year in the U.S. — the majority with no prior symptoms</p>
        </div>
      </div>
    </div>
  </section>

  <!-- What Happens After -->
  <section class="section-padding bg-white">
    <div class="container-site max-w-3xl">
      <div class="text-center mb-8 fade-in-up">
        <p class="overline text-gold mb-2">You're Not Left Alone With Your Results</p>
        <h2 class="text-3xl md:text-4xl font-serif text-charcoal">What Happens After Your Screening</h2>
      </div>
      <div class="space-y-4 fade-in-up">
        <div class="flex items-start gap-3 bg-ivory rounded-card p-5 border border-warmgray/40">
          <svg class="w-5 h-5 text-gold shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
          <p class="text-base font-sans text-charcoal">Your six studies are performed by ARDMS-certified sonographers with 10+ years of diagnostic ultrasound experience.</p>
        </div>
        <div class="flex items-start gap-3 bg-ivory rounded-card p-5 border border-warmgray/40">
          <svg class="w-5 h-5 text-gold shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
          <p class="text-base font-sans text-charcoal">All images are interpreted by a board-certified physician. You receive a clear written report within 2 business days.</p>
        </div>
        <div class="flex items-start gap-3 bg-ivory rounded-card p-5 border border-warmgray/40">
          <svg class="w-5 h-5 text-gold shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
          <p class="text-base font-sans text-charcoal">If anything needs follow-up, we help you understand what it means and can send your report directly to your doctor.</p>
        </div>
        <div class="flex items-start gap-3 bg-ivory rounded-card p-5 border border-warmgray/40">
          <svg class="w-5 h-5 text-gold shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
          <p class="text-base font-sans text-charcoal"><strong class="text-charcoal">Reports are imaging findings, not a diagnosis.</strong> Share them with your physician for clinical correlation and next steps.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Meet the Signal View Team -->
  <section class="section-padding bg-ivory">
    <div class="container-site">
      <div class="text-center mb-10 fade-in-up">
        <p class="overline text-gold mb-2">Meet the Signal View Team</p>
        <h2 class="text-3xl md:text-4xl font-serif text-charcoal">Real People. Real Expertise.</h2>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-3xl mx-auto fade-in-up">
        {team.map((member) => (
          <div class="text-center">
            <img
              src={member.image.src}
              alt={`${member.name}, ${member.role}`}
              class:list={[
                'w-24 h-24 md:w-28 md:h-28 rounded-full object-cover mx-auto shadow-md border-2 border-warmgray/30',
                member.name === 'Mike' ? 'object-center' : 'object-top',
              ]}
              loading="lazy"
            />
            <p class="mt-3 text-sm font-sans font-semibold text-charcoal">{member.name}</p>
            <p class="text-xs font-sans text-slate">{member.role}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Who Should Get Screened -->
  <section class="section-padding bg-white">
    <div class="container-site max-w-4xl">
      <div class="text-center mb-10 fade-in-up">
        <p class="overline text-gold mb-3">Is This For You?</p>
        <h2 class="text-3xl md:text-4xl font-serif text-charcoal">Who Benefits Most From a Full-Body Scan</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-2xl mx-auto fade-in-up">
        {whoShouldGet.map((item) => (
          <div class="flex items-center gap-3 p-4 rounded-xl bg-ivory border border-warmgray/20">
            <div class="w-8 h-8 rounded-full bg-gold/15 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </div>
            <span class="text-base font-sans text-charcoal">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Reviews -->
  <section class="section-padding bg-ivory">
    <div class="container-site max-w-6xl">
      <div class="text-center mb-10 fade-in-up">
        <div class="flex items-center justify-center gap-1 mb-3">
          {[1,2,3,4,5].map(() => (
            <svg class="w-7 h-7 text-gold" fill="currentColor" viewBox="0 0 20 20">
