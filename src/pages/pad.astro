---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import EmergencyBanner from '../components/EmergencyBanner.astro';
import { Image } from 'astro:assets';
import padHero from '../assets/images/service-pad.png';
import padCloseup from '../assets/images/pad-closeup.png';
import { siteConfig } from '../data/siteConfig';

const trustPoints = [
  { icon: 'clock', text: '20–30 Minutes' },
  { icon: 'shield', text: 'No Referral Needed' },
  { icon: 'heart', text: 'No Needles or Radiation' },
  { icon: 'check', text: 'Physician-Interpreted Results' },
];

const whatWeCheck = [
  {
    name: 'Femoral Arteries',
    conditions: 'Blockages in upper thigh arteries',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" d="M12 3v18M9 6c2 1 4 1 6 0M9 18c2-1 4-1 6 0"/></svg>`,
  },
  {
    name: 'Popliteal Arteries',
    conditions: 'Narrowing behind the knees',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v4m0 8v4M8 8c0 4 2 4 4 4s4 0 4-4M8 16c0-4 2-4 4-4s4 0 4 4"/></svg>`,
  },
  {
    name: 'Tibial Arteries',
    conditions: 'Reduced flow in lower legs',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" d="M10 3v18M14 3v18" /><path stroke-linecap="round" d="M8 9h8M8 15h8" opacity="0.5"/></svg>`,
  },
  {
    name: 'Dorsalis Pedis',
    conditions: 'Blood flow to the feet',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19c-3 0-5-1-6-3s-1-5 1-7 4-3 5-3 3 1 5 3 2 5 1 7-3 3-6 3z"/><path stroke-linecap="round" d="M12 12v4"/></svg>`,
  },
  {
    name: 'Blood Flow Velocity',
    conditions: 'Speed and direction of arterial blood flow',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>`,
  },
  {
    name: 'ABI Correlation',
    conditions: 'Ankle-brachial index assessment',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>`,
  },
];

const whyWait = [
  {
    stat: '8M+',
    heading: 'Americans have PAD',
    description: 'Peripheral artery disease affects over 8 million people — many don\'t know they have it until symptoms become severe.',
  },
  {
    stat: '50%',
    heading: 'of PAD cases go undiagnosed',
    description: 'Many people dismiss leg pain as "getting older." A simple ultrasound can tell the difference between aging and a dangerous blockage.',
  },
  {
    stat: '$250',
    heading: 'vs. $1,500+ through insurance',
    description: 'Skip the referral chain and high deductibles. Same diagnostic quality, physician-interpreted results, a fraction of the cost.',
  },
];

const whoShouldGet = [
  'Leg pain or cramping when walking',
  'Numbness or tingling in your legs or feet',
  'Cold feet or legs — one side colder than the other',
  'Non-healing sores or wounds on legs or feet',
  'Smoker or former smoker',
  'Diabetes, high blood pressure, or high cholesterol',
];
---

<BaseLayout
  title="Leg Arterial Ultrasound Las Vegas | $250 | Results in 2–3 Days"
  description="Diagnostic leg arterial (PAD) ultrasound in Las Vegas — $250, no referral needed. Images blood flow and arterial blockages from thigh to ankle. Results in 2–3 days."
>
  <EmergencyBanner />

  <!-- Hero -->
  <section class="relative overflow-hidden bg-navy">
    <div class="absolute inset-0 bg-gradient-to-br from-navy-dark/60 to-transparent"></div>
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-gold/5 rounded-full -translate-y-1/3 translate-x-1/3"></div>
    <div class="absolute bottom-0 left-0 w-[300px] h-[300px] bg-gold/3 rounded-full translate-y-1/2 -translate-x-1/3"></div>

    <div class="container-site relative py-20 md:py-28">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

        <!-- Hero image placeholder -->
        <div class="order-first lg:order-last fade-in-up">
          <Image
            src={padHero}
            alt="Woman experiencing leg pain — a common symptom of peripheral artery disease (PAD)"
            class="rounded-2xl shadow-2xl shadow-black/30 w-full"
            widths={[480, 768, 1024]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            quality={85}
          />
        </div>

        <div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif text-white leading-tight mb-4 fade-in-up">
            Leg Pain? Get a Closer Look This Week.
          </h1>
          <p class="text-xl md:text-2xl text-white/80 font-sans mb-2 fade-in-up">
            <span class="text-gold font-semibold">$250</span> · Leg Arterial (PAD) Ultrasound in Las Vegas
          </p>
          <p class="text-lg text-white/60 font-sans mb-8 max-w-2xl fade-in-up">
            A comprehensive ultrasound of your leg arteries — from the thigh to the ankle — imaging blood flow and signs of peripheral artery disease (PAD). Interpreted by a board-certified physician. Reports delivered in 2–3 business days. No referral or insurance needed.
          </p>

          <!-- IntakeQ booking widget -->
          <div class="mb-8 fade-in-up" id="book">
            <div id="intakeq" style="width: 100%;"></div>
          </div>

          <!-- Trust strip -->
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 fade-in-up">
            {trustPoints.map((point) => (
              <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-full bg-gold/15 flex items-center justify-center shrink-0">
                  {point.icon === 'clock' && (
                    <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" />
                    </svg>
                  )}
                  {point.icon === 'shield' && (
                    <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    </svg>
                  )}
                  {point.icon === 'heart' && (
                    <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z" />
                    </svg>
                  )}
                  {point.icon === 'check' && (
                    <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  )}
                </div>
                <span class="text-sm text-white/70 font-sans">{point.text}</span>
              </div>
            ))}
          </div>

          <!-- Location -->
          <div class="mt-6 flex items-start gap-2.5 text-sm text-white/70 font-sans fade-in-up">
            <svg class="w-4 h-4 text-gold shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <p class="leading-relaxed">
              {siteConfig.screeningLocation.address} · {siteConfig.screeningLocation.floor} · {siteConfig.screeningLocation.landmark}
              <a href={siteConfig.screeningLocation.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="text-gold hover:text-gold-light transition-colors whitespace-nowrap ml-1">— Get Directions →</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What We're Checking -->
  <section class="section-padding bg-white">
    <div class="container-site">
      <div class="text-center max-w-2xl mx-auto mb-12 fade-in-up">
        <p class="overline text-gold mb-3">Full Leg Arterial Scan</p>
        <h2 class="text-3xl md:text-4xl font-serif text-charcoal">From Thigh to Ankle — Every Artery Imaged</h2>
        <p class="mt-4 text-base text-slate font-sans">A diagnostic leg arterial ultrasound images blood flow in the femoral, popliteal, tibial, and dorsalis pedis arteries — interpreted by a board-certified physician.</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center max-w-5xl mx-auto">
        <!-- Closeup image placeholder -->
        <div class="fade-in-up">
          <Image
            src={padCloseup}
            alt="Sonographer analyzing leg arterial ultrasound with color doppler showing blood flow"
            class="rounded-2xl w-full aspect-[4/3] object-cover shadow-lg"
            widths={[480, 768]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            quality={85}
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 fade-in-up">
          {whatWeCheck.map((item) => (
            <div class="p-4 rounded-xl border border-warmgray/20 bg-ivory/50">
              <div class="w-10 h-10 bg-gold/10 rounded-full flex items-center justify-center mb-2 text-gold" set:html={item.icon} />
              <h3 class="font-sans font-semibold text-charcoal text-sm mb-1">{item.name}</h3>
              <p class="text-xs text-slate font-sans">{item.conditions}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Why It Matters -->
  <section class="section-padding bg-ivory">
    <div class="container-site">
      <div class="text-center max-w-2xl mx-auto mb-12 fade-in-up">
        <p class="overline text-gold mb-3">Don't Ignore the Signs</p>
        <h2 class="text-3xl md:text-4xl font-serif text-charcoal">Leg Pain Isn't Always "Just Getting Older"</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        {whyWait.map((item) => (
          <div class="text-center p-6 rounded-2xl border border-warmgray/30 bg-white fade-in-up">
            <p class="text-5xl font-serif text-gold mb-2">{item.stat}</p>
            <p class="text-lg font-sans font-semibold text-charcoal mb-2">{item.heading}</p>
            <p class="text-sm text-slate font-sans leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Credentials & What Happens After -->
  <section class="section-padding bg-white">
    <div class="container-site max-w-3xl">
      <div class="text-center mb-8 fade-in-up">
        <p class="overline text-gold mb-2">You're Not Left Alone With Your Results</p>
        <h2 class="text-3xl md:text-4xl font-serif text-charcoal">What Happens After Your Scan</h2>
      </div>
      <div class="space-y-4 fade-in-up">
        <div class="flex items-start gap-3 bg-ivory rounded-card p-5 border border-warmgray/40">
          <svg class="w-5 h-5 text-gold shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
          <p class="text-base font-sans text-charcoal">Your scan is performed by an ARDMS-certified sonographer with 10+ years of diagnostic ultrasound experience.</p>
        </div>
        <div class="flex items-start gap-3 bg-ivory rounded-card p-5 border border-warmgray/40">
          <svg class="w-5 h-5 text-gold shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
          <p class="text-base font-sans text-charcoal">Images are interpreted by a board-certified physician — you receive a clear written report in 2–3 business days.</p>
        </div>
        <div class="flex items-start gap-3 bg-ivory rounded-card p-5 border border-warmgray/40">
          <svg class="w-5 h-5 text-gold shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
          <p class="text-base font-sans text-charcoal">If anything needs follow-up, we help connect you with the right specialist and can send your report directly to your doctor.</p>
        </div>
        <div class="flex items-start gap-3 bg-ivory rounded-card p-5 border border-warmgray/40">
          <svg class="w-5 h-5 text-gold shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
          <p class="text-base font-sans text-charcoal"><strong class="text-charcoal">Reports are imaging findings, not a diagnosis.</strong> Share them with your physician for clinical correlation and next steps.</p>
        </div>
      </div>
    </div>
  </section>


  <!-- Who Should Get This Scan -->
  <section class="section-padding bg-ivory">
    <div class="container-site max-w-4xl">
      <div class="text-center mb-10 fade-in-up">
        <p class="overline text-gold mb-3">Is This For You?</p>
        <h2 class="text-3xl md:text-4xl font-serif text-charcoal">When a Leg Arterial Ultrasound May Help</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-2xl mx-auto fade-in-up">
        {whoShouldGet.map((item) => (
          <div class="flex items-center gap-3 p-4 rounded-xl bg-white border border-warmgray/20">
            <div class="w-8 h-8 rounded-full bg-gold/15 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </div>
            <span class="text-base font-sans text-charcoal">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Social Proof -->
  <section class="section-padding bg-white">
    <div class="container-site max-w-3xl text-center fade-in-up">
      <div class="flex items-center justify-center gap-1 mb-3">
        {[1,2,3,4,5].map(() => (
          <svg class="w-7 h-7 text-gold" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
        ))}
      </div>
      <p class="text-lg font-sans text-charcoal mb-2">5-Star Rated on Google</p>
      <p class="text-slate font-sans text-sm mb-6">Real reviews from real patients in Las Vegas</p>
      <a
        href={siteConfig.googleReviewsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm font-sans font-medium text-navy hover:text-gold transition-colors"
      >
        Read Our Reviews →
      </a>
    </div>
  </section>

  <!-- Final CTA -->
  <CTABanner
    heading="Get Imaging This Week — Then Take the Next Step With Your Doctor."
    subtext="$250 · Physician-interpreted results in 2–3 business days · No referral needed"
    ctaText="Book Your PAD Scan — $250"
    ctaHref="#book"
  />

  <!-- Schema.org structured data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "MedicalTest",
    "name": "Leg Arterial Ultrasound (PAD Screening)",
    "alternateName": "Peripheral Artery Disease Ultrasound",
    "description": "A diagnostic leg arterial ultrasound evaluating blood flow from the thigh to the ankle, checking for peripheral artery disease (PAD), blockages, and arterial narrowing. Physician-interpreted results in 2–3 business days.",
    "usesDevice": {
      "@type": "MedicalDevice",
      "name": "Ultrasound"
    },
    "offers": {
      "@type": "Offer",
      "name": "Leg Arterial Ultrasound (PAD)",
      "price": "250",
      "priceCurrency": "USD"
    },
    "provider": {
      "@type": "MedicalBusiness",
      "name": siteConfig.legalName,
      "telephone": siteConfig.phone,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": siteConfig.screeningLocation.address,
        "addressLocality": siteConfig.screeningLocation.city,
        "addressRegion": siteConfig.screeningLocation.state
      }
    }
  })} />
</BaseLayout>

<script is:inline>
  (function (c) {
    window.intakeq = "6a34384c4c7aa072929fbe5f";
    window.intakeqServiceId = "b5a458a6-21d3-4ef3-b801-56413f53a88d";
    var i = c.createElement("script");
    i.type = "text/javascript";
    i.async = true;
    i.src = "https://intakeq.com/js/widget.min.js?1";
    document.head.appendChild(i);
  })(document);
</script>
