---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PricingCard from '../components/PricingCard.astro';
import { siteConfig } from '../data/siteConfig';
import CTABanner from '../components/CTABanner.astro';
import { packages } from '../data/packages';
import { services } from '../data/services';
import { link } from '../utils/links';

---

<BaseLayout
  title="Screening Packages & Pricing | From $199 | Signal View Ultrasound Las Vegas"
  description="Transparent pricing for ultrasound screening packages. Essential Wellness $199, Executive Heart $349, Gold Standard $697 — six studies in one visit. No hidden fees. Las Vegas."
>
  <PageHero
    title="Transparent, Simple Pricing"
    subtitle="No hidden fees. No referrals. No insurance headaches."
    breadcrumbs={[{ label: 'Home', href: link('/') }, { label: 'Pricing' }]}
  />

  <!-- Trust Strip -->
  <section class="bg-navy border-b border-navy-dark">
    <div class="container-site py-3">
      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
        {[
          { icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z', text: 'Board-certified physician report included' },
          { icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z', text: 'Results delivered within 2 business days' },
          { icon: 'M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z', text: 'HSA/FSA eligible · No referral needed' },
          { icon: 'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z', text: '10+ years diagnostic imaging experience' },
        ].map(item => (
          <div class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-gold shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
            </svg>
            <span class="text-xs font-sans text-white/80">{item.text}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Package Cards -->
  <section class="section-padding bg-ivory">
    <div class="container-site">

      <!-- What to Expect -->
      <div class="max-w-3xl mx-auto mb-10 fade-in-up">
        <p class="text-center text-xs font-sans font-semibold uppercase tracking-widest text-slate mb-4">What to expect</p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {[
            { step: '1', label: 'Book online or call us', sub: 'Takes 2 minutes' },
            { step: '2', label: 'We confirm within 1 business day', sub: 'Personal follow-up' },
            { step: '3', label: 'Arrive for your appointment', sub: 'Comfortable, non-invasive' },
            { step: '4', label: 'Physician report in 2 business days', sub: 'Emailed directly to you' },
          ].map(item => (
            <div class="text-center">
              <div class="w-8 h-8 rounded-full bg-gold/10 border border-gold/30 flex items-center justify-center mx-auto mb-2">
                <span class="text-sm font-serif text-gold">{item.step}</span>
              </div>
              <p class="text-xs font-sans font-semibold text-charcoal leading-snug">{item.label}</p>
              <p class="text-xs font-sans text-slate mt-0.5">{item.sub}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 max-w-5xl mx-auto fade-in-up">
        {packages.map((pkg) => (
          <PricingCard pkg={pkg} showDetails={true} />
        ))}
      </div>

      <!-- Location strip -->
      <div class="max-w-3xl mx-auto mt-10 fade-in-up">
        <div class="bg-white rounded-2xl border border-warmgray/40 p-6 flex flex-col sm:flex-row items-center sm:items-start gap-4">
          <div class="w-12 h-12 rounded-full bg-gold/15 flex items-center justify-center shrink-0">
            <svg class="w-6 h-6 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          </div>
          <div class="text-center sm:text-left flex-1">
            <p class="overline text-gold mb-1">In-Clinic Appointments</p>
            <p class="text-base font-sans font-semibold text-charcoal">{siteConfig.screeningLocation.address}</p>
            <p class="text-sm text-slate font-sans">{siteConfig.screeningLocation.city}, {siteConfig.screeningLocation.state} {siteConfig.screeningLocation.zip}</p>
            <p class="text-sm text-slate font-sans">{siteConfig.screeningLocation.floor} · {siteConfig.screeningLocation.landmark} · {siteConfig.hours}</p>
            <a href={siteConfig.screeningLocation.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="inline-block mt-2 text-sm text-navy font-medium hover:text-gold transition-colors">Get Directions →</a>
          </div>
        </div>
      </div>

      <div class="max-w-2xl mx-auto mt-8 fade-in-up space-y-3">
        <p class="text-center text-sm font-sans text-slate">
          <svg class="w-4 h-4 text-gold inline-block mr-1 -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          We see a limited number of clients each week — Saturday appointments fill quickly.
        </p>
        <div class="bg-white rounded-card p-6 border border-warmgray/40 text-center">
          <p class="text-sm font-sans text-charcoal leading-relaxed">
            Every screening includes a physician-interpreted report delivered within 2 business days. Screenings are elective and cash-pay — HSA/FSA eligible.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison Table -->
  <section class="section-padding bg-white">
    <div class="container-site max-w-4xl">
      <div class="text-center mb-10 fade-in-up">
        <h2 class="text-3xl md:text-4xl font-serif text-charcoal">Package Comparison</h2>
        <p class="mt-3 text-lg text-slate font-sans">See exactly what's included in each package</p>
      </div>

      <div class="overflow-x-auto fade-in-up">
        <table class="w-full border-collapse">
          <thead>
            <tr>
              <th class="text-left py-4 px-4 text-sm font-sans font-semibold text-slate border-b-2 border-warmgray">Screening / Feature</th>
              {packages.map((pkg) => (
                <th class:list={[
                  'text-center py-4 px-4 text-sm font-sans font-semibold border-b-2',
                  pkg.highlighted ? 'text-gold border-gold' : 'text-charcoal border-warmgray',
                ]}>
                  {pkg.name}
                  <span class="block text-xs font-normal text-slate mt-0.5">${pkg.price}</span>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {services.map((service) => (
              <tr class="border-b border-warmgray/50">
                <td class="py-3.5 px-4 text-sm font-sans text-charcoal">{service.shortTitle}</td>
                {packages.map((pkg) => (
                  <td class="py-3.5 px-4 text-center">
                    {service.includedIn.includes(pkg.name) ? (
                      <svg class="w-5 h-5 text-gold mx-auto" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                      </svg>
                    ) : (
                      <svg class="w-5 h-5 text-warmgray mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M18 12H6" />
                      </svg>
                    )}
                  </td>
                ))}
              </tr>
            ))}
            <!-- Duration row -->
            <tr>
              <td class="py-3.5 px-4 text-sm font-sans font-semibold text-charcoal">Duration</td>
              {packages.map((pkg) => (
                <td class="py-3.5 px-4 text-center text-sm font-sans text-charcoal">{pkg.duration}</td>
              ))}
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Bundles -->
  <section id="bundles" class="section-padding bg-ivory">
    <div class="container-site">
      <div class="text-center max-w-2xl mx-auto mb-12 fade-in-up">
        <p class="overline text-gold mb-3">Coming With Someone?</p>
        <h2 class="text-3xl md:text-4xl font-serif text-charcoal">Save When You Book Together</h2>
        <p class="mt-3 text-slate font-sans">Bring a loved one and get two full Executive Heart screenings for less than the cost of booking separately.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-3xl mx-auto fade-in-up">
        <!-- Bring a Loved One -->
        <div class="bg-white rounded-2xl border border-warmgray/40 p-7 flex flex-col">
          <div class="inline-block self-start mb-4">
            <span class="text-xs font-sans font-semibold text-navy bg-navy/8 px-3 py-1 rounded-full border border-navy/20">Bundle</span>
          </div>
          <h3 class="text-xl font-serif text-charcoal mb-1">Bring a Loved One</h3>
          <p class="text-sm text-slate font-sans mb-4">Executive Heart × 2</p>
          <p class="text-4xl font-serif text-charcoal mb-1">$599</p>
          <p class="text-sm text-gold font-sans font-semibold mb-1">$299.50 per person — save $99 vs. booking separately</p>
          <p class="text-sm text-slate font-sans mb-6 leading-relaxed">Two complete Executive Heart screenings — full cardiac workup including echocardiogram. Ideal for couples or an adult child booking with a parent.</p>
          <ul class="space-y-2 mb-8 flex-1">
            {['Two Executive Heart screenings', 'Carotid, Aorta, Leg Artery (ABI) + Echo for each', 'Same appointment or separate visits', '$299.50 per person — save $49.50 each'].map((item) => (
              <li class="flex items-start gap-2 text-xs font-sans text-slate">
                <svg class="w-3.5 h-3.5 text-gold shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
          <a href="#bundle-inquiry" class="block w-full text-center py-3 border-2 border-navy text-navy hover:bg-navy hover:text-white font-sans font-semibold text-sm rounded-lg transition-all duration-200" onclick="window.svs_track && window.svs_track('cta_click', { link_text: 'Inquire About This Option', link_location: 'bundle_loved_one' })">
            Inquire About This Option
          </a>
        </div>

        <!-- Annual Wellness Membership -->
        <div class="bg-white rounded-2xl border border-gold shadow-md shadow-gold/10 ring-1 ring-gold/20 p-7 flex flex-col">
          <div class="inline-block self-start mb-4">
            <span class="text-xs font-sans font-semibold text-white bg-gold px-3 py-1 rounded-full">Best Value</span>
          </div>
          <h3 class="text-xl font-serif text-charcoal mb-1">Annual Wellness Membership</h3>
          <p class="text-sm text-slate font-sans mb-4">Executive Heart · Once a Year</p>
          <div class="flex items-baseline gap-1 mb-1">
            <p class="text-4xl font-serif text-gold">$299</p>
            <span class="text-lg text-slate font-sans">/yr</span>
          </div>
          <p class="text-sm text-gold font-sans font-semibold mb-1">Save $50 vs. standard rate · Priority scheduling included</p>
          <p class="text-sm text-slate font-sans mb-6 leading-relaxed">One Executive Heart screening per year — lock in today's price with priority scheduling guaranteed. The easiest way to make this an annual habit.</p>
          <ul class="space-y-2 mb-8 flex-1">
            {['One Executive Heart screening per year', 'Lock in today\'s pricing', 'Priority scheduling — book before general availability', 'Annual renewal reminder'].map((item) => (
              <li class="flex items-start gap-2 text-xs font-sans text-slate">
                <svg class="w-3.5 h-3.5 text-gold shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
          <a href="#bundle-inquiry" class="block w-full text-center py-3 bg-gold hover:bg-gold-hover text-white font-sans font-semibold text-sm rounded-lg transition-all duration-200 shadow-sm hover:shadow-md" onclick="window.svs_track && window.svs_track('cta_click', { link_text: 'Inquire About This Option', link_location: 'bundle_membership' })">
            Inquire About This Option
          </a>
        </div>
      </div>

      <!-- Bundle Inquiry Form -->
      <div id="bundle-inquiry" class="max-w-2xl mx-auto mt-16 fade-in-up">
        <div class="text-center mb-8">
          <h3 class="text-2xl font-serif text-charcoal">Inquire About a Bundle</h3>
          <p class="mt-2 text-sm text-slate font-sans">No payment collected here. Our team will follow up within 1 business day.</p>
        </div>
        <form id="bundle-form" class="bg-white rounded-2xl border border-warmgray/40 p-7 space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="bi-name" class="block text-sm font-sans font-medium text-charcoal mb-1.5">Full Name *</label>
              <input type="text" id="bi-name" name="name" required
                class="w-full px-4 py-3 border border-warmgray rounded-lg text-sm font-sans text-charcoal placeholder:text-slate/50 focus:outline-none focus:ring-2 focus:ring-gold/50 focus:border-gold transition-colors"
                placeholder="Your full name" />
            </div>
            <div>
              <label for="bi-phone" class="block text-sm font-sans font-medium text-charcoal mb-1.5">Phone Number *</label>
              <input type="tel" id="bi-phone" name="phone" required
                class="w-full px-4 py-3 border border-warmgray rounded-lg text-sm font-sans text-charcoal placeholder:text-slate/50 focus:outline-none focus:ring-2 focus:ring-gold/50 focus:border-gold transition-colors"
                placeholder="(702) 555-0123" />
            </div>
          </div>
          <div>
            <label for="bi-email" class="block text-sm font-sans font-medium text-charcoal mb-1.5">Email Address *</label>
            <input type="email" id="bi-email" name="email" required
              class="w-full px-4 py-3 border border-warmgray rounded-lg text-sm font-sans text-charcoal placeholder:text-slate/50 focus:outline-none focus:ring-2 focus:ring-gold/50 focus:border-gold transition-colors"
              placeholder="you@example.com" />
          </div>
          <div>
            <label for="bi-option" class="block text-sm font-sans font-medium text-charcoal mb-1.5">Which option are you interested in? *</label>
            <select id="bi-option" name="option" required
              class="w-full px-4 py-3 border border-warmgray rounded-lg text-sm font-sans text-charcoal focus:outline-none focus:ring-2 focus:ring-gold/50 focus:border-gold transition-colors bg-white">
              <option value="">Select an option...</option>
              <option value="Bring a Loved One — Executive Heart ($599)">Bring a Loved One — Executive Heart ($599)</option>
              <option value="Annual Wellness Membership ($299/yr)">Annual Wellness Membership ($299/yr)</option>
            </select>
          </div>
          <div>
            <label for="bi-message" class="block text-sm font-sans font-medium text-charcoal mb-1.5">Message (optional)</label>
            <textarea id="bi-message" name="message" rows="2"
              class="w-full px-4 py-3 border border-warmgray rounded-lg text-sm font-sans text-charcoal placeholder:text-slate/50 focus:outline-none focus:ring-2 focus:ring-gold/50 focus:border-gold transition-colors resize-none"
              placeholder="Any questions or special requests..."></textarea>
          </div>
          <div class="hidden" aria-hidden="true">
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </div>
          <button type="submit" class="w-full py-3.5 bg-gold hover:bg-gold-hover text-white font-sans font-semibold rounded-lg transition-all duration-200 shadow-sm hover:shadow-md">
            Send Inquiry
          </button>
          <p class="text-center text-xs text-slate font-sans">No payment collected here. Our team will follow up within 1 business day.</p>
        </form>
      </div>
    </div>
  </section>

  <!-- Gold Standard Booking -->
  <section id="gold-standard-inquiry" class="section-padding bg-white">
    <div class="container-site max-w-5xl">
      <div class="text-center mb-10 fade-in-up">
        <p class="overline text-gold mb-3">The Gold Standard — $697</p>
        <h2 class="text-2xl md:text-3xl font-serif text-charcoal">Book Your Full Body Scan</h2>
        <p class="text-slate font-sans text-sm mt-2 max-w-xl mx-auto">Six ultrasound studies in one 60-minute in-clinic visit. The most comprehensive scan we offer.</p>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start fade-in-up">
        <ul class="space-y-3">
          {['Carotid Artery Ultrasound', 'Aorta Aneurysm Screening', 'Leg Artery Screening with ABI', 'Echocardiogram (Heart Ultrasound)', 'Abdomen Complete Ultrasound', 'Thyroid Ultrasound', 'Physician-interpreted report within 2 business days'].map((item) => (
            <li class="flex items-center gap-2.5 text-sm font-sans text-charcoal">
              <svg class="w-4 h-4 text-gold shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              {item}
            </li>
          ))}
        </ul>
        <div id="intakeq-gold" style="width: 100%;"></div>
      </div>
    </div>
  </section>

  <!-- Value Justification -->
  <section class="section-padding bg-ivory">
    <div class="container-site max-w-4xl">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center fade-in-up">
        <div>
          <p class="overline text-gold mb-3">Worth Every Dollar</p>
          <h2 class="text-3xl md:text-4xl font-serif text-charcoal">Why These Screenings Are an Investment, Not an Expense</h2>
          <p class="mt-4 text-slate font-sans leading-relaxed">
            The cost of a preventable emergency dwarfs the cost of early detection. Our screenings give you answers, peace of mind, and — most importantly — time.
          </p>
        </div>
        <div class="space-y-4">
          <div class="bg-white rounded-card p-5 border border-warmgray/40">
            <div class="flex items-baseline justify-between">
              <span class="text-sm text-slate font-sans">ER visit for stroke</span>
              <span class="text-lg font-serif text-charcoal">$20,000+</span>
            </div>
          </div>
          <div class="bg-white rounded-card p-5 border border-warmgray/40">
            <div class="flex items-baseline justify-between">
              <span class="text-sm text-slate font-sans">Heart surgery</span>
              <span class="text-lg font-serif text-charcoal">$100,000+</span>
            </div>
          </div>
          <div class="bg-white rounded-card p-5 border border-gold shadow-md">
            <div class="flex items-baseline justify-between">
              <span class="text-sm text-gold-hover font-sans font-semibold">Signal View screening</span>
              <span class="text-lg font-serif text-gold">From $199</span>
            </div>
          </div>
          <p class="text-sm text-slate font-sans">
            <span class="font-medium text-charcoal">HSA/FSA eligible.</span> Preventative screenings are typically covered by health savings and flexible spending accounts.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CTABanner heading="Questions About Our Packages?" subtext="Our team is happy to help you choose the right screening for your needs." ctaText="Contact Us" ctaHref={link('/contact')} />

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      // Bundle inquiry form
      var bundleForm = document.getElementById('bundle-form');
      if (bundleForm) {
        bundleForm.addEventListener('submit', function(e) {
          e.preventDefault();
          var honeypot = bundleForm.querySelector('input[name="website"]');
          if (honeypot && honeypot.value) return;
          var data = new FormData(bundleForm);
          var entries = {};
          data.forEach(function(value, key) { entries[key] = value; });
          var option = entries.option || '';
          var subject = encodeURIComponent('Bundle Inquiry — ' + option);
          var body = encodeURIComponent(
            'Name: ' + entries.name +
            '\nPhone: ' + entries.phone +
            '\nEmail: ' + entries.email +
            '\nOption: ' + option +
            '\nMessage: ' + (entries.message || 'None')
          );
          window.svs_track && window.svs_track('generate_lead', { form_name: 'bundle_inquiry' });
          window.location.href = 'mailto:info@svscreenings.com?subject=' + subject + '&body=' + body;
          var btn = bundleForm.querySelector('button[type="submit"]');
          if (btn) {
            btn.textContent = 'Opening Email — Thank You!';
            btn.classList.remove('bg-gold', 'hover:bg-gold-hover');
            btn.classList.add('bg-green-600');
            btn.disabled = true;
          }
        });
      }
    });
  </script>

  <script is:inline>
    (function (c) {
      window.intakeq = "6a34384c4c7aa072929fbe5f";
      window.intakeqServiceId = "90f5acc3-6f0b-4dbc-ad3e-503b3220b6ac";
      var i = c.createElement("script");
      i.type = "text/javascript";
      i.async = true;
      i.src = "https://intakeq.com/js/widget.min.js?1";
      document.head.appendChild(i);
      // Move widget into gold section container after load
      i.onload = function() {
        var target = document.getElementById('intakeq-gold');
        var widget = document.getElementById('intakeq');
        if (target && widget && widget !== target) target.appendChild(widget);
      };
    })(document);

    window.addEventListener('message', function(e) {
      if (!e.data) return;
      var d = e.data;
      if (
        d.type === 'intakeqBookingCreated' ||
        d.type === 'appointmentBooked' ||
        d.action === 'appointmentCreated' ||
        d.event === 'appointment_booked'
      ) {
        window.svs_track && window.svs_track('generate_lead', { form_name: 'gold_standard', value: 697, currency: 'USD' });
      }
    });
  </script>
</BaseLayout>
