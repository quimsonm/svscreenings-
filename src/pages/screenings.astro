---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import EmergencyBanner from '../components/EmergencyBanner.astro';
import { Image } from 'astro:assets';
import screeningsHero from '../assets/images/concierge-home.png';
import echoCloseup from '../assets/images/echo-closeup.jpg';
import teamMike from '../assets/images/Mike.jpg';
import teamJackie from '../assets/images/Jackie.jpg';
import teamPriya from '../assets/images/Priya.jpg';
import teamRemi from '../assets/images/Remi.jpg';
import { packages } from '../data/packages';
import { siteConfig } from '../data/siteConfig';
import { testimonials } from '../data/testimonials';
import { link } from '../utils/links';

const EXECUTIVE_URL = packages.find(p => p.slug === 'executive-heart')?.squareUrl ?? '#';

const team = [
  { name: 'Mike', role: 'Sonographer', image: teamMike },
  { name: 'Jackie', role: 'Sonographer', image: teamJackie },
  { name: 'Priya', role: 'Sonographer', image: teamPriya },
  { name: 'Remi', role: 'Sonographer', image: teamRemi },
];

const studies = [
  {
    name: 'Carotid Artery Ultrasound',
    description: 'Imaging of the neck arteries that supply blood to your brain.',
    detail: 'Flags plaque buildup that elevates stroke risk.',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 4v16M8 8c2 2 4 2 6 0M8 16c2-2 4-2 6 0" stroke-linecap="round"/></svg>`,
    highlight: false,
  },
  {
    name: 'Abdominal Aorta Ultrasound',
    description: "Imaging of the body's main artery in the abdomen.",
    detail: 'Screens for aortic aneurysm — often called the "silent killer."',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path d="M12 3v4M12 17v4M10 7c-2 2-3 4-3 7s1 3 3 3h4c2 0 3 0 3-3s-1-5-3-7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="1.5"/></svg>`,
    highlight: false,
  },
  {
    name: 'Leg Arterial Ultrasound',
    description: 'Imaging of the arteries from thigh to ankle.',
    detail: 'Screens for peripheral artery disease (PAD) and reduced circulation.',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path d="M11 3c0 2-1 5-1 8s1 5 1 8M13 3c0 2 1 5 1 8s-1 5-1 8" stroke-linecap="round"/><path d="M9 9h6M9 15h6" stroke-linecap="round" opacity="0.5"/></svg>`,
    highlight: false,
  },
  {
    name: 'Screening Echocardiogram',
    description: 'Quick ultrasound check of heart function and valves.',
    detail: 'Ejection fraction (EF) and valve screening — flags concerns worth deeper investigation.',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
    highlight: true,
  },
];

const whoShouldGet = [
  "You're 50 or older",
  'Family history of stroke or heart disease',
  'High blood pressure or high cholesterol',
  'Diabetes or pre-diabetes',
  'Smoker or former smoker',
  'You want peace of mind about your cardiovascular health',
];
---

<BaseLayout
  title="Executive Heart Screening Las Vegas | $349 | Signal View"
  description="4 ultrasounds in 30 minutes — carotid, aorta, leg arteries, and a screening echocardiogram. Physician-interpreted in 2–3 days. $349. Las Vegas, no referral needed."
>
  <EmergencyBanner />

  <!-- Hero — offer front and center, bookable above the fold -->
  <section class="relative overflow-hidden bg-navy">
    <div class="absolute inset-0 bg-gradient-to-br from-navy-dark/60 to-transparent"></div>
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-gold/5 rounded-full -translate-y-1/3 translate-x-1/3"></div>
    <div class="absolute bottom-0 left-0 w-[300px] h-[300px] bg-gold/3 rounded-full translate-y-1/2 -translate-x-1/3"></div>

    <div class="container-site relative py-12 md:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <!-- Hero text -->
        <div class="lg:col-span-7 fade-in-up">
          <p class="overline text-gold mb-4">Most Complete Cardiovascular Screening in Las Vegas</p>
          <h1 class="text-3xl md:text-4xl lg:text-5xl font-serif text-white leading-tight mb-4">
            Comprehensive Cardiovascular Screening Done Right
          </h1>
          <p class="text-lg md:text-xl text-white/85 font-sans mb-2">
            <span class="text-gold font-semibold">$349</span> · Heart + Vascular + Stroke-Risk Imaging — All in One Visit
          </p>
          <p class="text-base text-white/70 font-sans mb-6 max-w-2xl">
            Carotid arteries, abdominal aorta, leg arteries, plus a screening echocardiogram — performed by ARDMS-certified sonographers with 10+ years of diagnostic experience. Physician-read report in 2–3 business days.
          </p>

          <!-- What's included quick-glance -->
          <div class="grid grid-cols-2 md:grid-cols-4 gap-2 mb-6 max-w-2xl">
            <div class="bg-white/10 border border-white/15 rounded-lg p-3 backdrop-blur">
              <div class="text-gold mb-1">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 4v16M8 8c2 2 4 2 6 0M8 16c2-2 4-2 6 0" stroke-linecap="round"/></svg>
              </div>
              <p class="text-xs text-white font-sans font-semibold leading-tight">Carotid Arteries</p>
              <p class="text-[10px] text-white/60 font-sans">Stroke risk</p>
            </div>
            <div class="bg-white/10 border border-white/15 rounded-lg p-3 backdrop-blur">
              <div class="text-gold mb-1">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path d="M12 3v4M12 17v4M10 7c-2 2-3 4-3 7s1 3 3 3h4c2 0 3 0 3-3s-1-5-3-7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="1.5"/></svg>
              </div>
              <p class="text-xs text-white font-sans font-semibold leading-tight">Abdominal Aorta</p>
              <p class="text-[10px] text-white/60 font-sans">Aneurysm check</p>
            </div>
            <div class="bg-white/10 border border-white/15 rounded-lg p-3 backdrop-blur">
              <div class="text-gold mb-1">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path d="M11 3c0 2-1 5-1 8s1 5 1 8M13 3c0 2 1 5 1 8s-1 5-1 8" stroke-linecap="round"/></svg>
              </div>
              <p class="text-xs text-white font-sans font-semibold leading-tight">Leg Arteries</p>
              <p class="text-[10px] text-white/60 font-sans">PAD screening</p>
            </div>
            <div class="bg-white/10 border border-white/15 rounded-lg p-3 backdrop-blur">
              <div class="text-gold mb-1">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              <p class="text-xs text-white font-sans font-semibold leading-tight">Screening Echo</p>
              <p class="text-[10px] text-white/60 font-sans">EF + valve check</p>
            </div>
          </div>

          <!-- Hero CTAs -->
          <div class="flex flex-col sm:flex-row gap-3 mb-6">
            <a
              href={EXECUTIVE_URL}
              target="_blank"
              rel="noopener noreferrer"
              onclick="window.svs_track && window.svs_track('begin_checkout', { item_name: 'Executive Heart', value: 349, currency: 'USD', link_location: 'screenings_hero' })"
              class="inline-flex items-center justify-center px-8 py-4 bg-gold hover:bg-gold-hover text-white font-sans font-semibold text-lg rounded-lg transition-all duration-200 shadow-lg hover:shadow-xl"
            >
              Book Your Screening — $349
            </a>
            <a
              href={`tel:${siteConfig.phoneTel}`}
              onclick="window.svs_track && window.svs_track('click_phone', { link_location: 'screenings_hero' })"
              class="inline-flex items-center justify-center gap-2 px-6 py-4 border-2 border-white/30 hover:border-white/60 text-white font-sans font-medium rounded-lg transition-all duration-200"
            >
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              Call {siteConfig.phone}
            </a>
          </div>

          <!-- Trust strip -->
          <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-white/70 font-sans">
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              ARDMS-Certified Sonographers
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Physician-Read Reports
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              HSA/FSA Eligible
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              No Referral Needed
            </span>
          </div>

          <!-- Location -->
          <div class="mt-6 flex items-start gap-2.5 text-sm text-white/70 font-sans fade-in-up">
            <svg class="w-4 h-4 text-gold shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <p class="leading-relaxed">
              {siteConfig.screeningLocation.address} · {siteConfig.screeningLocation.floor} · {siteConfig.screeningLocation.landmark}
              <a href={siteConfig.screeningLocation.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="text-gold hover:text-gold-light transition-colors whitespace-nowrap ml-1">— Get Directions →</a>
            </p>
          </div>
        </div>

        <!-- Booking-ready price card with hero image -->
        <div class="lg:col-span-5 fade-in-up">
          <div class="relative">
            <Image
              src={screeningsHero}
              alt="Premium concierge healthcare experience — Signal View Screenings Las Vegas"
              class="rounded-2xl shadow-2xl w-full aspect-[4/3] object-cover mb-4"
              widths={[480, 768]}
              sizes="(max-width: 1024px) 100vw, 40vw"
              quality={85}
            />
          </div>
          <div class="bg-white rounded-2xl shadow-2xl p-6 -mt-12 relative z-10 mx-2">
            <div class="inline-block bg-gold text-white text-xs font-sans font-semibold tracking-wide px-3 py-1 rounded-full mb-3">Most Popular</div>
            <p class="text-sm text-slate font-sans font-medium mb-1">Executive Heart Package</p>
            <p class="text-5xl font-serif text-charcoal mb-1">$349</p>
            <p class="text-sm text-slate font-sans mb-5">~45 minutes · One visit · Reports in 2–3 days</p>

            <ul class="space-y-2 mb-6">
              <li class="flex items-start gap-2 text-sm font-sans text-charcoal">
                <svg class="w-4 h-4 text-gold shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                Carotid artery ultrasound (stroke risk)
              </li>
              <li class="flex items-start gap-2 text-sm font-sans text-charcoal">
                <svg class="w-4 h-4 text-gold shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                Abdominal aorta screening (aneurysm)
              </li>
              <li class="flex items-start gap-2 text-sm font-sans text-charcoal">
                <svg class="w-4 h-4 text-gold shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                Leg arterial ultrasound (PAD)
              </li>
              <li class="flex items-start gap-2 text-sm font-sans text-charcoal">
                <svg class="w-4 h-4 text-gold shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                Screening echocardiogram (EF + valves)
              </li>
              <li class="flex items-start gap-2 text-sm font-sans text-charcoal">
                <svg class="w-4 h-4 text-gold shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                Board-certified physician interpretation
              </li>
            </ul>

            <a
              href={EXECUTIVE_URL}
              target="_blank"
              rel="noopener noreferrer"
              onclick="window.svs_track && window.svs_track('begin_checkout', { item_name: 'Executive Heart', value: 349, currency: 'USD', link_location: 'screenings_hero_card' })"
              class="block w-full text-center py-4 bg-gold hover:bg-gold-hover text-white font-sans font-semibold text-lg rounded-lg transition-all duration-200 shadow-md hover:shadow-lg"
            >
              Book &amp; Pay $75 Deposit →
            </a>
            <p class="text-center text-xs text-slate font-sans mt-3">$75 deposit · Remainder at visit · Secure checkout via Square</p>

            <!-- Location -->
            <div class="mt-5 pt-4 border-t border-warmgray/30">
              <div class="flex items-start gap-2.5 text-sm font-sans text-charcoal">
                <svg class="w-4 h-4 text-gold shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                <div>
                  <p class="font-semibold text-charcoal mb-0.5">In-Clinic Location</p>
                  <div>{siteConfig.screeningLocation.address}</div>
                  <div>{siteConfig.screeningLocation.city}, {siteConfig.screeningLocation.state} {siteConfig.screeningLocation.zip}</div>
                  <div class="text-slate text-xs mt-0.5">{siteConfig.screeningLocation.floor} · {siteConfig.screeningLocation.landmark}</div>
                  <a href={siteConfig.screeningLocation.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="text-navy font-medium hover:text-gold transition-colors">Get Directions →</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What's Included -->
  <section class="section-padding bg-white">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center max-w-6xl mx-auto mb-12">
        <div class="fade-in-up">
          <p class="overline text-gold mb-3">What's Included</p>
          <h2 class="text-3xl md:text-4xl font-serif text-charcoal mb-4">Four Studies. One Visit. One Comprehensive Picture.</h2>
          <p class="text-base text-slate font-sans leading-relaxed">Most screening providers skip the heart muscle exam. We include a screening echocardiogram in every Executive Heart package — a quick check of cardiac function (ejection fraction) and valve health, alongside the vascular studies. That's what makes this package different.</p>
        </div>
        <div class="fade-in-up">
          <Image
            src={echoCloseup}
            alt="Sonographer reviewing screening echocardiogram findings on monitor"
            class="rounded-2xl w-full aspect-[4/3] object-cover shadow-lg"
            widths={[480, 768]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            quality={85}
          />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 max-w-5xl mx-auto fade-in-up">
        {studies.map((study) => (
          <div class={study.highlight ? "bg-ivory/50 rounded-xl p-5 border-2 border-gold relative" : "bg-ivory/50 rounded-xl p-5 border border-warmgray/40"}>
            {study.highlight && (
              <div class="absolute -top-2 right-3 bg-gold text-white text-[10px] font-sans font-semibold px-2 py-0.5 rounded-full">UNIQUE TO US</div>
            )}
            <div class={study.highlight ? "w-10 h-10 bg-gold/15 rounded-full flex items-center justify-center mb-3 text-gold" : "w-10 h-10 bg-gold/10 rounded-full flex items-center justify-center mb-3 text-gold"} set:html={study.icon} />
            <h3 class="font-sans font-semibold text-charcoal text-sm mb-1">{study.name}</h3>
            <p class="text-xs text-slate font-sans mb-2">{study.description}</p>
            <p class="text-xs text-slate font-sans">{study.detail}</p>
          </div>
        ))}
      </div>

      <p class="text-center text-xs text-slate font-sans italic mt-6 max-w-2xl mx-auto">
        Note: The screening echocardiogram is a focused exam (EF and valve check) — not a full diagnostic echo. If a more detailed cardiac evaluation is needed, our <a href={link('/echo')} class="text-navy hover:text-gold underline transition-colors">full diagnostic echocardiogram</a> is available separately.
      </p>
    </div>
  </section>

  <!-- Why This Combination -->
  <section class="section-padding bg-ivory">
    <div class="container-site max-w-4xl">
      <div class="text-center mb-10 fade-in-up">
        <p class="overline text-gold mb-3">Why This Combination</p>
        <h2 class="text-3xl md:text-4xl font-serif text-charcoal">Heart Disease, Stroke, and Vascular Issues Share Underlying Risk Factors</h2>
        <p class="mt-4 text-base text-slate font-sans max-w-2xl mx-auto leading-relaxed">Plaque buildup, high blood pressure, and aging arteries don't show up in just one place. A screening that only checks the carotid arteries can miss what's happening in the aorta. One that skips the heart muscle can miss early signs of cardiac dysfunction. Looking at all four together gives you and your doctor a more complete cardiovascular picture.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 fade-in-up">
        <div class="bg-white rounded-2xl p-6 border border-warmgray/30 text-center">
          <p class="text-4xl font-serif text-gold mb-2">Up to 80%</p>
          <p class="text-sm text-slate font-sans">of strokes are preventable when risk factors are identified and managed early</p>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-warmgray/30 text-center">
          <p class="text-4xl font-serif text-gold mb-2">~6,000</p>
          <p class="text-sm text-slate font-sans">aortic aneurysm-related deaths per year in the U.S. — often with no warning symptoms</p>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-warmgray/30 text-center">
          <p class="text-4xl font-serif text-gold mb-2">8M+</p>
          <p class="text-sm text-slate font-sans">Americans live with peripheral artery disease (PAD), many undiagnosed</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Credentials & What Happens After -->
  <section class="section-padding bg-white">
    <div class="container-site max-w-3xl">
      <div class="text-center mb-8 fade-in-up">
        <p class="overline text-gold mb-2">You're Not Left Alone With Your Results</p>
        <h2 class="text-3xl md:text-4xl font-serif text-charcoal">What Happens After Your Screening</h2>
      </div>
      <div class="space-y-4 fade-in-up">
        <div class="flex items-start gap-3 bg-ivory rounded-card p-5 border border-warmgray/40">
          <svg class="w-5 h-5 text-gold shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
          <p class="text-base font-sans text-charcoal">Your scans are performed by ARDMS-certified sonographers with 10+ years of diagnostic ultrasound experience.</p>
        </div>
        <div class="flex items-start gap-3 bg-ivory rounded-card p-5 border border-warmgray/40">
          <svg class="w-5 h-5 text-gold shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
          <p class="text-base font-sans text-charcoal">Images are interpreted by a board-certified physician — you receive a clear written report in 2–3 business days.</p>
        </div>
        <div class="flex items-start gap-3 bg-ivory rounded-card p-5 border border-warmgray/40">
          <svg class="w-5 h-5 text-gold shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
          <p class="text-base font-sans text-charcoal">If anything needs follow-up, we help connect you with the right specialist and can send your report directly to your doctor.</p>
        </div>
        <div class="flex items-start gap-3 bg-ivory rounded-card p-5 border border-warmgray/40">
          <svg class="w-5 h-5 text-gold shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
          <p class="text-base font-sans text-charcoal"><strong class="text-charcoal">Reports are imaging findings, not a diagnosis.</strong> Share them with your physician for clinical correlation and next steps.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Meet the Signal View Team -->
  <section class="section-padding bg-ivory">
    <div class="container-site">
      <div class="text-center mb-10 fade-in-up">
        <p class="overline text-gold mb-2">Meet the Signal View Team</p>
        <h2 class="text-3xl md:text-4xl font-serif text-charcoal">Real People. Real Expertise.</h2>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-3xl mx-auto fade-in-up">
        {team.map((member) => (
          <div class="text-center">
            <img
              src={member.image.src}
              alt={`${member.name}, ${member.role}`}
              class:list={[
                'w-24 h-24 md:w-28 md:h-28 rounded-full object-cover mx-auto shadow-md border-2 border-warmgray/30',
                member.name === 'Mike' ? 'object-center' : 'object-top',
              ]}
              loading="lazy"
            />
            <p class="mt-3 text-sm font-sans font-semibold text-charcoal">{member.name}</p>
            <p class="text-xs font-sans text-slate">{member.role}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Who Should Get Screened -->
  <section class="section-padding bg-white">
    <div class="container-site max-w-4xl">
      <div class="text-center mb-10 fade-in-up">
        <p class="overline text-gold mb-3">Is This For You?</p>
        <h2 class="text-3xl md:text-4xl font-serif text-charcoal">When Cardiovascular Screening May Help</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-2xl mx-auto fade-in-up">
        {whoShouldGet.map((item) => (
          <div class="flex items-center gap-3 p-4 rounded-xl bg-ivory border border-warmgray/20">
            <div class="w-8 h-8 rounded-full bg-gold/15 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </div>
            <span class="text-base font-sans text-charcoal">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Reviews — all visible -->
  <section class="section-padding bg-ivory">
    <div class="container-site max-w-6xl">
      <div class="text-center mb-10 fade-in-up">
        <div class="flex items-center justify-center gap-1 mb-3">
          {[1,2,3,4,5].map(() => (
            <svg class="w-7 h-7 text-gold" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))}
        </div>
        <p class="overline text-gold mb-2">5.0 ★ Rated on Google</p>
        <h2 class="text-3xl md:text-4xl font-serif text-charcoal">What Our Patients Say</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 fade-in-up">
        {testimonials.map((t) => (
          <div class="bg-white rounded-2xl p-6 border border-warmgray/40 shadow-sm flex flex-col">
            <div class="flex gap-0.5 mb-3">
              {Array.from({ length: t.rating }).map(() => (
                <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <p class="text-sm text-charcoal font-sans leading-relaxed mb-4 italic flex-1">&ldquo;{t.quote}&rdquo;</p>
            <p class="text-xs font-sans font-semibold text-slate">— {t.name}</p>
          </div>
        ))}
      </div>

      <div class="text-center mt-8">
        <a
          href={siteConfig.googleReviewsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block text-sm font-sans font-medium text-navy hover:text-gold transition-colors"
        >
          See All Reviews on Google →
        </a>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTABanner
    heading="Get the Full Picture in One Visit."
    subtext="Heart, vascular, and stroke-risk imaging — all in 45 minutes. Reports in 2–3 business days. Serving Las Vegas, Henderson, Summerlin & North Las Vegas."
    ctaText="Book Executive Heart — $349"
    ctaHref={EXECUTIVE_URL}
  />

  <!-- Schema.org structured data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "MedicalProcedure",
    "name": "Executive Heart Cardiovascular Screening",
    "alternateName": "Comprehensive Cardiovascular Screening Package",
    "description": "A comprehensive cardiovascular screening package including carotid artery ultrasound, abdominal aorta screening, leg arterial ultrasound, and a screening echocardiogram (ejection fraction and valve check). Physician-interpreted reports in 2-3 business days.",
    "procedureType": "Diagnostic Procedure",
    "offers": {
      "@type": "Offer",
      "name": "Executive Heart Screening",
      "price": "349",
      "priceCurrency": "USD",
      "url": EXECUTIVE_URL
    },
    "provider": {
      "@type": "MedicalBusiness",
      "name": siteConfig.legalName,
      "telephone": siteConfig.phone,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": siteConfig.screeningLocation.address,
        "addressLocality": siteConfig.screeningLocation.city,
        "addressRegion": siteConfig.screeningLocation.state
      }
    }
  })} />
</BaseLayout>
