---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import EmergencyBanner from '../components/EmergencyBanner.astro';
import { Image } from 'astro:assets';
import dvtHero from '../assets/images/pad-closeup.png';
import { siteConfig } from '../data/siteConfig';

const trustPoints = [
  { icon: 'clock', text: '20–30 Minutes' },
  { icon: 'shield', text: 'No Referral Needed' },
  { icon: 'heart', text: 'No Needles or Radiation' },
  { icon: 'check', text: 'Physician-Interpreted Results' },
];

const whatWeCheck = [
  {
    name: 'Deep Vein Thrombosis',
    conditions: 'Blood clots in the deep leg veins',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
  },
  {
    name: 'Venous Insufficiency',
    conditions: 'Poorly functioning vein valves',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>`,
  },
  {
    name: 'Superficial Clots',
    conditions: 'Thrombophlebitis in surface veins',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="8"/><path stroke-linecap="round" d="M9 12h6"/></svg>`,
  },
  {
    name: 'Valve Function',
    conditions: 'Venous valve competency assessment',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
  },
  {
    name: 'Venous Reflux',
    conditions: 'Backward blood flow in the veins',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>`,
  },
  {
    name: 'Compression Response',
    conditions: 'Vein compressibility to rule out clot',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>`,
  },
];

const whyWait = [
  {
    stat: '900K',
    heading: 'Americans affected by DVT/PE yearly',
    description: 'DVT and pulmonary embolism are among the most preventable causes of death. Early detection makes all the difference.',
  },
  {
    stat: '30%',
    heading: 'of untreated DVT leads to PE',
    description: 'A clot that travels from the leg to the lungs can be fatal. A simple ultrasound can rule out or confirm DVT before that happens.',
  },
  {
    stat: '$1,500+',
    heading: 'typical hospital imaging cost',
    description: 'An emergency or hospital-based venous ultrasound can run $1,500 or more. Ours is $300, same-week appointments available.',
  },
];

const whoShouldGet = [
  'Leg swelling, pain, or redness',
  'Recent long-haul flight or road trip',
  'Post-surgery or extended bed rest',
  'Taking oral contraceptives or hormone therapy',
  'Family history of blood clots or clotting disorders',
  'Previous DVT or pulmonary embolism',
];
---

<BaseLayout
  title="DVT Leg Vein Ultrasound Las Vegas | $300 Blood Clot Screening | Signal View"
  description="$300 leg venous ultrasound in Las Vegas. Detects DVT, blood clots, and venous insufficiency. Physician-interpreted results in 2–3 days. No referral needed."
>
  <EmergencyBanner />

  <!-- Hero -->
  <section class="relative overflow-hidden bg-navy">
    <div class="absolute inset-0 bg-gradient-to-br from-navy-dark/60 to-transparent"></div>
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-gold/5 rounded-full -translate-y-1/3 translate-x-1/3"></div>
    <div class="absolute bottom-0 left-0 w-[300px] h-[300px] bg-gold/3 rounded-full translate-y-1/2 -translate-x-1/3"></div>

    <div class="container-site relative py-20 md:py-28">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

        <div class="order-first lg:order-last fade-in-up">
          <Image
            src={dvtHero}
            alt="Sonographer performing a leg venous ultrasound to check for DVT at Signal View Screenings in Las Vegas"
            class="rounded-2xl shadow-2xl shadow-black/30 w-full"
            widths={[480, 768, 1024]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            quality={85}
          />
        </div>

        <div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif text-white leading-tight mb-4 fade-in-up">
            Leg Pain or Swelling? Rule Out a Blood Clot.
          </h1>
          <p class="text-xl md:text-2xl text-white/80 font-sans mb-2 fade-in-up">
            <span class="text-gold font-semibold">$300</span> · Leg Venous Ultrasound (DVT)
          </p>
          <p class="text-lg text-white/60 font-sans mb-8 max-w-2xl fade-in-up">
            Deep vein thrombosis (DVT) is a blood clot in the leg veins that can travel to the lungs and become life-threatening. A venous ultrasound can detect or rule it out — with physician-interpreted results in 2–3 business days. No referral needed.
          </p>

          <!-- IntakeQ booking widget -->
          <div class="mb-8 fade-in-up" id="book">
            <div id="intakeq" style="width: 100%;"></div>
          </div>

          <!-- Trust strip -->
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 fade-in-up">
            {trustPoints.map((point) => (
              <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-full bg-gold/15 flex items-center justify-center shrink-0">
                  {point.icon === 'clock' && (
                    <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" />
                    </svg>
                  )}
                  {point.icon === 'shield' && (
                    <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    </svg>
                  )}
                  {point.icon === 'heart' && (
                    <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z" />
                    </svg>
                  )}
                  {point.icon === 'check' && (
                    <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  )}
                </div>
                <span class="text-sm text-white/70 font-sans">{point.text}</span>
              </div>
            ))}
          </div>

          <!-- Location -->
          <div class="mt-6 flex items-start gap-2.5 text-sm text-white/70 font-sans fade-in-up">
            <svg class="w-4 h-4 text-gold shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <p class="leading-relaxed">
              {siteConfig.screeningLocation.address} · {siteConfig.screeningLocation.floor} · {siteConfig.screeningLocation.landmark}
              <a href={siteConfig.screeningLocation.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="text-gold hover:text-gold-light transition-colors whitespace-nowrap ml-1">— Get Directions →</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What We Check -->
  <section class="section-padding bg-white">
    <div class="container-site">
      <div class="text-center max-w-2xl mx-auto mb-12 fade-in-up">
        <p class="overline text-gold mb-3">Venous Evaluation</p>
        <h2 class="text-3xl md:text-4xl font-serif text-charcoal">What a Leg Venous Ultrasound Evaluates</h2>
        <p class="mt-4 text-base text-slate font-sans">A complete venous duplex ultrasound of the legs checks for blood clots, venous insufficiency, valve function, and reflux — interpreted by a board-certified physician.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-5xl mx-auto fade-in-up">
        {whatWeCheck.map((item) => (
          <div class="p-4 rounded-xl border border-warmgray/20 bg-ivory/50">
            <div class="w-10 h-10 bg-gold/10 rounded-full flex items-center justify-center mb-2 text-gold" set:html={item.icon} />
            <h3 class="font-sans font-semibold text-charcoal text-sm mb-1">{item.name}</h3>
            <p class="text-xs text-slate font-sans">{item.conditions}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Wait? -->
  <section class="section-padding bg-ivory">
    <div class="container-site">
      <div class="text-center max-w-2xl mx-auto mb-12 fade-in-up">
        <p class="overline text-gold mb-3">Skip the Runaround</p>
        <h2 class="text-3xl md:text-4xl font-serif text-charcoal">Don't Wait Weeks to Rule Out a Clot</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        {whyWait.map((item) => (
          <div class="text-center p-6 rounded-2xl border border-warmgray/30 bg-white fade-in-up">
            <p class="text-5xl font-serif text-gold mb-2">{item.stat}</p>
            <p class="text-lg font-sans font-semibold text-charcoal mb-2">{item.heading}</p>
            <p class="text-sm text-slate font-sans leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Who Should Get This Scan -->
  <section class="section-padding bg-white">
    <div class="container-site max-w-4xl">
      <div class="text-center mb-10 fade-in-up">
        <p class="overline text-gold mb-3">Is This For You?</p>
        <h2 class="text-3xl md:text-4xl font-serif text-charcoal">You Should Get Scanned If...</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-2xl mx-auto fade-in-up">
        {whoShouldGet.map((item) => (
          <div class="flex items-center gap-3 p-4 rounded-xl bg-ivory border border-warmgray/20">
            <div class="w-8 h-8 rounded-full bg-gold/15 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </div>
            <span class="text-base font-sans text-charcoal">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Social Proof -->
  <section class="section-padding bg-ivory">
    <div class="container-site max-w-3xl text-center fade-in-up">
      <div class="flex items-center justify-center gap-1 mb-3">
        {[1,2,3,4,5].map(() => (
          <svg class="w-7 h-7 text-gold" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
        ))}
      </div>
      <p class="text-lg font-sans text-charcoal mb-2">5-Star Rated on Google</p>
      <p class="text-slate font-sans text-sm mb-6">Real reviews from real patients in Las Vegas</p>
      <a href={siteConfig.googleReviewsUrl} target="_blank" rel="noopener noreferrer" class="text-sm font-sans font-medium text-navy hover:text-gold transition-colors">
        Read Our Reviews →
      </a>
    </div>
  </section>

  <!-- Final CTA -->
  <CTABanner
    heading="Don't Let a Clot Go Undetected. Get Scanned."
    subtext="$300 · Physician-interpreted results in 2–3 business days · No referral needed"
    ctaText="Book Your DVT Screening — $300"
    ctaHref="#book"
  />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "MedicalTest",
    "name": "Leg Venous Ultrasound (DVT)",
    "alternateName": "Lower Extremity Venous Duplex",
    "description": "A venous duplex ultrasound of the legs to detect deep vein thrombosis (DVT), venous insufficiency, and valve dysfunction. Physician-interpreted results in 2–3 business days.",
    "usesDevice": { "@type": "MedicalDevice", "name": "Ultrasound" },
    "offers": {
      "@type": "Offer",
      "name": "Leg Venous Ultrasound",
      "price": "300",
      "priceCurrency": "USD"
    },
    "provider": {
      "@type": "MedicalBusiness",
      "name": siteConfig.legalName,
      "telephone": siteConfig.phone,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": siteConfig.screeningLocation.address,
        "addressLocality": siteConfig.screeningLocation.city,
        "addressRegion": siteConfig.screeningLocation.state
      }
    }
  })} />
</BaseLayout>

<script is:inline>
  (function (c) {
    window.intakeq = "6a34384c4c7aa072929fbe5f";
    window.intakeqServiceId = "38044a1e-87e8-4a34-8268-75717477cb90";
    var i = c.createElement("script");
    i.type = "text/javascript";
    i.async = true;
    i.src = "https://intakeq.com/js/widget.min.js?1";
    document.head.appendChild(i);
  })(document);
</script>
