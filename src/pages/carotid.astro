---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import { Image } from 'astro:assets';
import carotidImg from '../assets/images/carotid-screening.jpg';
import { siteConfig } from '../data/siteConfig';
import { link } from '../utils/links';

const SQUARE_CAROTID_URL = 'https://book.squareup.com/appointments/1scmcc76vpn2fe/location/L0GR90314NDDP/services/POGYV6J3GYEXET4JTSGRNMON';

const trustPoints = [
  { icon: 'clock', text: '15 Minutes' },
  { icon: 'shield', text: 'No Referral Needed' },
  { icon: 'heart', text: 'No Needles or Radiation' },
  { icon: 'check', text: 'Results in 1 Business Day' },
];

const whyItMatters = [
  {
    stat: '80%',
    heading: 'of strokes are preventable',
    description: 'Most strokes are caused by a blockage that builds up silently over years. Early detection changes outcomes.',
  },
  {
    stat: '~50%',
    heading: 'of adults have carotid plaque',
    description: 'Plaque buildup in your carotid arteries is more common than most people realize — especially after age 50. A CIMT test can measure it before symptoms appear.',
  },
  {
    stat: '15 min',
    heading: 'is all it takes',
    description: 'A quick, painless ultrasound of your neck arteries can reveal what you can\'t feel — before it becomes an emergency.',
  },
];

const whoShouldGet = [
  'Over 50 years old',
  'Family history of stroke or heart disease',
  'High blood pressure or high cholesterol',
  'Diabetes or pre-diabetes',
  'Smoker or former smoker',
  'Simply want peace of mind',
];

const whatYouGet = [
  'One-on-one with an experienced sonographer — not an assembly line',
  'Real-time ultrasound of both left and right carotid arteries',
  'CIMT measurement — carotid intima-media thickness assessment',
  'Plaque buildup detection and arterial wall evaluation',
  'Results reviewed by a board-certified physician',
  'Follow-up within 1 business day',
];
---

<BaseLayout
  title="Carotid Ultrasound Las Vegas | $300 Diagnostic Scan | Signal View Screenings"
  description="$300 diagnostic carotid ultrasound and CIMT (carotid intima-media thickness) test in Las Vegas. Checks for plaque buildup and stroke risk in 15 minutes. Physician-interpreted results. No referral needed."
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-navy">
    <div class="absolute inset-0 bg-gradient-to-br from-navy-dark/60 to-transparent"></div>
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-gold/5 rounded-full -translate-y-1/3 translate-x-1/3"></div>
    <div class="absolute bottom-0 left-0 w-[300px] h-[300px] bg-gold/3 rounded-full translate-y-1/2 -translate-x-1/3"></div>

    <div class="container-site relative py-20 md:py-28">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

      <!-- Hero image (mobile: above text, desktop: right side) -->
      <div class="order-first lg:order-last fade-in-up">
        <Image
          src={carotidImg}
          alt="Sonographer performing a carotid artery ultrasound screening on a patient"
          class="rounded-2xl shadow-2xl shadow-black/30 w-full"
          widths={[480, 768, 1024]}
          sizes="(max-width: 1024px) 100vw, 50vw"
          quality={85}
        />
      </div>

      <div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif text-white leading-tight mb-4 fade-in-up">
          Know Your Stroke Risk
        </h1>
        <p class="text-xl md:text-2xl text-white/80 font-sans mb-2 fade-in-up">
          <span class="text-gold font-semibold">$300</span> · Carotid Artery / CIMT Ultrasound
        </p>
        <p class="text-lg text-white/60 font-sans mb-8 max-w-2xl fade-in-up">
          A 15-minute carotid intima-media thickness (CIMT) ultrasound that checks for plaque buildup and arterial thickening — before it becomes an emergency.
        </p>

        <!-- IntakeQ booking widget -->
        <div class="mb-8 fade-in-up" id="book">
          <div id="intakeq" style="width: 100%;"></div>
        </div>

        <!-- Trust strip -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 fade-in-up">
          {trustPoints.map((point) => (
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-full bg-gold/15 flex items-center justify-center shrink-0">
                {point.icon === 'clock' && (
                  <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" />
                  </svg>
                )}
                {point.icon === 'shield' && (
                  <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                  </svg>
                )}
                {point.icon === 'heart' && (
                  <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z" />
                  </svg>
                )}
                {point.icon === 'check' && (
                  <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                )}
              </div>
              <span class="text-sm text-white/70 font-sans">{point.text}</span>
            </div>
          ))}
        </div>

        <!-- Location -->
        <div class="mt-6 flex items-start gap-2.5 text-sm text-white/70 font-sans fade-in-up">
          <svg class="w-4 h-4 text-gold shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <p class="leading-relaxed">
            {siteConfig.screeningLocation.address} · {siteConfig.screeningLocation.floor} · {siteConfig.screeningLocation.landmark}
            <a href={siteConfig.screeningLocation.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="text-gold hover:text-gold-light transition-colors whitespace-nowrap ml-1">— Get Directions →</a>
          </p>
        </div>
      </div>
      </div>
    </div>
  </section>

  <!-- Why This Matters -->
  <section class="section-padding bg-white">
    <div class="container-site">
      <div class="text-center max-w-2xl mx-auto mb-12 fade-in-up">
        <p class="overline text-gold mb-3">Why It Matters</p>
        <h2 class="text-3xl md:text-4xl font-serif text-charcoal">Strokes Don't Warn You. This Screening Does.</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        {whyItMatters.map((item) => (
          <div class="text-center p-6 rounded-2xl border border-warmgray/30 bg-ivory/50 fade-in-up">
            <p class="text-5xl font-serif text-gold mb-2">{item.stat}</p>
            <p class="text-lg font-sans font-semibold text-charcoal mb-2">{item.heading}</p>
            <p class="text-sm text-slate font-sans leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What You'll Get -->
  <section class="section-padding bg-ivory">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center max-w-5xl mx-auto">
        <div class="fade-in-up">
          <p class="overline text-gold mb-3">What's Included</p>
          <h2 class="text-3xl md:text-4xl font-serif text-charcoal mb-6">Your Carotid / CIMT Ultrasound</h2>
          <ul class="space-y-4">
            {whatYouGet.map((item) => (
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-gold shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                <span class="text-base font-sans text-charcoal">{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white rounded-2xl border border-warmgray/30 p-8 text-center fade-in-up">
          <p class="overline text-gold mb-2">Carotid / CIMT Ultrasound</p>
          <p class="text-6xl font-serif text-charcoal mb-1">$300</p>
          <p class="text-sm text-slate font-sans mb-6">15-minute diagnostic scan · Physician-interpreted</p>
          <a
            href="#book"
            class="block w-full py-4 bg-gold hover:bg-gold-hover text-white font-sans font-semibold text-lg rounded-lg transition-all duration-200 shadow-lg hover:shadow-xl mb-4"
          >
            Book Your Scan →
          </a>
          <p class="text-xs text-slate font-sans">HSA/FSA eligible · Same-week appointments available</p>
          <div class="mt-4 pt-4 border-t border-warmgray/20">
            <p class="text-xs text-slate font-sans">Or text us to book:</p>
            <a
              href={`sms:${siteConfig.phoneTel}`}
              onclick="window.svs_track && window.svs_track('click_text', { link_location: 'carotid_pricing_card' })"
              class="text-sm font-sans font-semibold text-navy hover:text-gold transition-colors"
            >
              {siteConfig.phone}
            </a>
          </div>
          <!-- Location -->
          <div class="mt-4 pt-4 border-t border-warmgray/20 text-left">
            <div class="flex items-start gap-2.5 text-sm font-sans text-charcoal">
              <svg class="w-4 h-4 text-gold shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              <div>
                <p class="font-semibold text-charcoal mb-0.5">In-Clinic Location</p>
                <div>{siteConfig.screeningLocation.address}</div>
                <div>{siteConfig.screeningLocation.city}, {siteConfig.screeningLocation.state} {siteConfig.screeningLocation.zip}</div>
                <div class="text-slate text-xs mt-0.5">{siteConfig.screeningLocation.floor} · {siteConfig.screeningLocation.landmark}</div>
                <a href={siteConfig.screeningLocation.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="text-navy font-medium hover:text-gold transition-colors">Get Directions →</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What Is CIMT -->
  <section class="section-padding bg-white">
    <div class="container-site max-w-4xl">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center fade-in-up">
        <div>
          <p class="overline text-gold mb-3">The Test Everyone's Talking About</p>
          <h2 class="text-3xl md:text-4xl font-serif text-charcoal mb-4">What Is a CIMT Test?</h2>
          <p class="text-base font-sans text-slate leading-relaxed mb-4">
            CIMT stands for <strong class="text-charcoal">Carotid Intima-Media Thickness</strong> — a non-invasive ultrasound measurement of the inner lining of your carotid arteries. It's one of the earliest detectable markers of cardiovascular disease.
          </p>
          <p class="text-base font-sans text-slate leading-relaxed">
            Doctors, cardiologists, and longevity experts are increasingly recommending CIMT as a baseline screening — even for people with no symptoms. It measures what blood work alone can't see: the actual condition of your artery walls.
          </p>
        </div>
        <div class="bg-ivory rounded-2xl border border-warmgray/20 p-6">
          <p class="text-sm font-sans font-semibold text-charcoal mb-4">CIMT screening can detect:</p>
          <ul class="space-y-3">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-gold shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              <span class="text-sm font-sans text-charcoal">Arterial wall thickening before plaque forms</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-gold shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              <span class="text-sm font-sans text-charcoal">Early-stage plaque buildup (atherosclerosis)</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-gold shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              <span class="text-sm font-sans text-charcoal">Elevated stroke and heart attack risk</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-gold shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              <span class="text-sm font-sans text-charcoal">Changes over time when used as a baseline</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Who Should Get Screened -->
  <section class="section-padding bg-ivory">
    <div class="container-site max-w-4xl">
      <div class="text-center mb-10 fade-in-up">
        <p class="overline text-gold mb-3">Is This For You?</p>
        <h2 class="text-3xl md:text-4xl font-serif text-charcoal">You Should Get Screened If...</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-2xl mx-auto fade-in-up">
        {whoShouldGet.map((item) => (
          <div class="flex items-center gap-3 p-4 rounded-xl bg-ivory border border-warmgray/20">
            <div class="w-8 h-8 rounded-full bg-gold/15 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </div>
            <span class="text-base font-sans text-charcoal">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Upgrade Section (soft upsell) -->
  <section class="section-padding bg-white">
    <div class="container-site max-w-4xl">
      <div class="text-center mb-10 fade-in-up">
        <p class="overline text-gold mb-3">While You're Here</p>
        <h2 class="text-3xl md:text-4xl font-serif text-charcoal">Want the Full Picture?</h2>
        <p class="mt-3 text-slate font-sans max-w-xl mx-auto">Most clients add the full vascular check while they're already in the clinic. Ask your sonographer about upgrading when you arrive.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-3xl mx-auto fade-in-up">
        <!-- Essential -->
        <div class="rounded-2xl border border-warmgray/30 bg-white p-6">
          <p class="text-sm font-sans font-medium text-slate mb-1">Essential Wellness</p>
          <p class="text-3xl font-serif text-charcoal mb-2">$199</p>
          <ul class="space-y-2 mb-4">
            <li class="flex items-start gap-2 text-sm font-sans text-slate">
              <svg class="w-4 h-4 text-gold shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Carotid + Aorta + Leg Arterial
            </li>
            <li class="flex items-start gap-2 text-sm font-sans text-slate">
              <svg class="w-4 h-4 text-gold shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              ~45 minute appointment
            </li>
          </ul>
          <a href={link('/pricing')} class="block w-full text-center py-2.5 rounded-lg font-sans font-semibold text-sm bg-navy hover:bg-navy/90 text-white transition-all duration-200">
            Learn More →
          </a>
        </div>

        <!-- Executive -->
        <div class="rounded-2xl border border-gold shadow-lg shadow-gold/10 ring-1 ring-gold/30 bg-white p-6">
          <div class="inline-block bg-gold text-white text-xs font-sans font-semibold tracking-wide px-3 py-1 rounded-full mb-2">Most Popular</div>
          <p class="text-sm font-sans font-medium text-slate mb-1">Executive Heart</p>
          <p class="text-3xl font-serif text-gold mb-2">$349</p>
          <ul class="space-y-2 mb-4">
            <li class="flex items-start gap-2 text-sm font-sans text-slate">
              <svg class="w-4 h-4 text-gold shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Everything in Essential + Echo
            </li>
            <li class="flex items-start gap-2 text-sm font-sans text-slate">
              <svg class="w-4 h-4 text-gold shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Most comprehensive in-clinic option
            </li>
          </ul>
          <a href={link('/pricing')} class="block w-full text-center py-2.5 rounded-lg font-sans font-semibold text-sm bg-gold hover:bg-gold-hover text-white transition-all duration-200">
            Learn More →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Social Proof -->
  <section class="section-padding bg-ivory">
    <div class="container-site max-w-3xl text-center fade-in-up">
      <div class="flex items-center justify-center gap-1 mb-3">
        {[1,2,3,4,5].map(() => (
          <svg class="w-7 h-7 text-gold" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
        ))}
      </div>
      <p class="text-lg font-sans text-charcoal mb-2">5-Star Rated on Google</p>
      <p class="text-slate font-sans text-sm mb-6">Real reviews from real patients in Las Vegas</p>
      <a
        href={siteConfig.googleReviewsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm font-sans font-medium text-navy hover:text-gold transition-colors"
      >
        Read Our Reviews →
      </a>
    </div>
  </section>

  <!-- Final CTA -->
  <CTABanner
    heading="Know Your Stroke Risk in 15 Minutes."
    subtext="$300 · Carotid ultrasound + CIMT measurement · Physician-interpreted report in 1 business day · No referral needed."
    ctaText="Book Your Carotid Ultrasound — $300"
    ctaHref="#book"
  />

  <!-- Schema.org structured data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "MedicalTest",
    "name": "Carotid Artery / CIMT Ultrasound Screening",
    "alternateName": "Carotid Intima-Media Thickness Test",
    "description": "A 15-minute carotid ultrasound and CIMT screening that measures intima-media thickness and checks for plaque buildup in the neck arteries to assess stroke and cardiovascular risk.",
    "usesDevice": {
      "@type": "MedicalDevice",
      "name": "Ultrasound"
    },
    "offers": {
      "@type": "Offer",
      "price": "300",
      "priceCurrency": "USD",
    },
    "provider": {
      "@type": "MedicalBusiness",
      "name": siteConfig.legalName,
      "telephone": siteConfig.phone,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": siteConfig.screeningLocation.address,
        "addressLocality": siteConfig.screeningLocation.city,
        "addressRegion": siteConfig.screeningLocation.state
      }
    }
  })} />
</BaseLayout>

<script is:inline>
  (function (c) {
    window.intakeq = "6a34384c4c7aa072929fbe5f";
    window.intakeqServiceId = "f5cfafad-d2c7-4554-bcea-9f8c4ae4fe7a";
    var i = c.createElement("script");
    i.type = "text/javascript";
    i.async = true;
    i.src = "https://intakeq.com/js/widget.min.js?1";
    document.head.appendChild(i);
  })(document);
</script>
